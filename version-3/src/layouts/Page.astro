---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/book.css';
import '../styles/pages.css';

import Book from '../components/Book.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Trial from '../components/Trial.astro';
import { site } from '../config/site';
import { getDict, type Lang } from '../i18n';
import { asset } from '../lib/format';

/** The whole site in one language: the book, then the trial form. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const meta = t.pages.home;

const hasUrl = site.url.length > 0;
const address = (which: Lang) => `${site.url}${asset(which === 'bn' ? '/bn/index.html' : '/index.html')}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: site.name,
  alternateName: [site.nameBn, site.nameAr],
  description: meta.description,
  areaServed: 'US',
  ...(hasUrl ? { url: address(lang), logo: `${site.url}${asset('/favicon.svg')}` } : {}),
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#170b0e" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />

    {
      hasUrl && (
        <>
          <link rel="canonical" href={address(lang)} />
          <link rel="alternate" hreflang="en" href={address('en')} />
          <link rel="alternate" hreflang="bn" href={address('bn')} />
          <link rel="alternate" hreflang="x-default" href={address('en')} />
          <meta property="og:url" content={address(lang)} />
          <meta property="og:image" content={`${site.url}${asset('/og.png')}`} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_US'} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      // Marks that scripts run. The pages stay hidden until the book script has
      // bound them; if that script never arrives, show them as a plain column.
      (function (root) {
        root.classList.replace('no-js', 'js');
        setTimeout(function () {
          if (!root.dataset.book) root.dataset.book = 'flat';
        }, 3000);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <Book lang={lang} />
      <Trial lang={lang} />
    </main>
    <Footer lang={lang} />
  </body>
</html>

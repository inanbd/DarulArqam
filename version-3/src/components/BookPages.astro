---
import PageShell from './PageShell.astro';
import Plate from './Plate.astro';
import Rosette from './Rosette.astro';
import Star from './Star.astro';
import { alimiyah, deeniyat, framework, hifz, nazirah, programs } from '../content/academy';
import { site } from '../config/site';
import { teachers } from '../config/teachers';
import { arabic, getDict, type Lang } from '../i18n';
import { chapters, firstPage } from '../lib/chapters';
import { asset, counter, num } from '../lib/format';

/**
 * The sixty-four pages of the book, in reading order.
 *
 * Each chapter opens with its verse on a left-hand page and has an even number
 * of pages. If you add or remove a page, renumber the ones after it and update
 * `src/lib/chapters.ts`. A page has a fixed size, so each one says only a little;
 * the full curriculum is in `src/content/academy.ts`.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.common;
const p = t.teachers.profiles;

/** The first sentence of a paragraph, for pages that have room for no more. */
const first = (text: string) => text.split(/(?<=\.)\s/)[0];

const men = teachers.filter((teacher) => teacher.gender === 'male');
const women = teachers.filter((teacher) => teacher.gender === 'female');
const teacherPages = [
  { people: men, number: 52, title: p.male, note: '' },
  { people: women, number: 53, title: p.female, note: p.femaleNote },
];
// Nine of the questions, three to a page. The site's other designs carry them all.
const questions = t.faq.items.slice(0, 9);
const questionPages = [0, 1, 2].map((index) => ({ items: questions.slice(index * 3, index * 3 + 3), number: 60 + index }));
const programChapter = { nazirah: 'nazirah', hifz: 'hifz', alimiyah: 'alimiyah' } as const;
const whatsapp = site.contact.whatsappNumber ? `https://wa.me/${site.contact.whatsappNumber}` : '';
const { junior, youth, adult, policies } = alimiyah;
---

<!-- ================= Home: 1–6 ================= -->

<PageShell lang={lang} number={1} chapter="home" kind="plate">
  <Plate lang={lang} chapter="home" />
</PageShell>

<PageShell lang={lang} number={2} chapter="home">
  <p class="rubric">{t.hero.eyebrow}</p>
  <h1 class="page__title page__title--large">
    {t.hero.title.before}<em>{t.hero.title.accent}</em>{t.hero.title.after}
  </h1>
  <p class="page__lead">{t.hero.lead}</p>
  <ul class="points" data-optional>
    {t.hero.points.map((point) => <li><Star />{point}</li>)}
  </ul>
  <p class="page__actions">
    <a class="btn btn--leather" href="#trial">{t.hero.primary}</a>
    <a class="btn btn--line" href={`#p-${firstPage('programs')}`} data-goto>{t.hero.secondary}</a>
  </p>
</PageShell>

<PageShell lang={lang} number={3} chapter="home">
  <p class="rubric">{t.brand.name}</p>
  <h2 class="page__title">{t.book.contents}</h2>
  <nav class="contents contents--tight" aria-label={t.book.contents}>
    {
      chapters.map((chapter) => (
        <a href={`#p-${chapter.first}`} data-goto>
          <span>{t.pages[chapter.id].nav}</span>
          <span class="contents__number">{num(chapter.first, lang)}</span>
        </a>
      ))
    }
  </nav>
  <p class="contents__note" data-optional>{t.book.contentsNote}</p>
</PageShell>

<PageShell lang={lang} number={4} chapter="home">
  <p class="rubric">{t.brand.tagline}</p>
  <h2 class="page__title">{c.different}</h2>
  <ul class="entries">
    {
      t.pillars.map((pillar) => (
        <li class="entry">
          <span class="entry__mark"><Star variant="double" /></span>
          <div>
            <h3 class="entry__title">{pillar.title}</h3>
            <p class="entry__text">{pillar.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</PageShell>

<PageShell lang={lang} number={5} chapter="home">
  <p class="rubric">{t.audience.eyebrow}</p>
  <h2 class="page__title">{t.audience.title}</h2>
  <ul class="entries">
    {
      t.audience.items.map((item, index) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{num(index + 1, lang)}</span></span>
          <div>
            <h3 class="entry__title">{item.title}</h3>
            <p class="entry__text">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="page__aside" data-optional>{t.audience.note}</p>
</PageShell>

<PageShell lang={lang} number={6} chapter="home">
  <p class="rubric">{t.pillars[3].title}</p>
  <h2 class="page__title">{t.how.time.title}</h2>
  <p class="page__text">{t.how.time.text}</p>
  <div class="clocks" hidden data-clock data-locale={lang === 'bn' ? 'bn-BD' : 'en-US'} aria-hidden="true">
    <div class="clock">
      <span class="clock__label">{t.how.time.yours}</span>
      <span class="clock__time" data-clock-local>--:--</span>
      <span class="clock__day" data-clock-zone></span>
    </div>
    <div class="clock clock--dhaka">
      <span class="clock__label">{t.how.time.dhaka}</span>
      <span class="clock__time" data-clock-dhaka>--:--</span>
      <span class="clock__day" data-clock-day></span>
    </div>
  </div>
  <p class="zones" data-optional>{t.how.time.zones}</p>
</PageShell>

<!-- ================= About: 7–12 ================= -->

<PageShell lang={lang} number={7} chapter="about" kind="plate">
  <Plate lang={lang} chapter="about" />
</PageShell>

<PageShell lang={lang} number={8} chapter="about">
  <p class="rubric">{t.about.eyebrow}</p>
  <h2 class="page__title">{t.about.title}</h2>
  <div class="fleuron" aria-hidden="true"><Star variant="double" /></div>
  <p class="page__text page__text--opening">{t.about.paragraphs[0]}</p>
</PageShell>

<PageShell lang={lang} number={9} chapter="about">
  <figure>
    <div class="seal">
      <Rosette />
      <p class="seal__name" lang="ar" dir="rtl">{arabic.name}</p>
    </div>
    <figcaption class="seal__caption">{t.about.medallionCaption}</figcaption>
  </figure>
  <p class="page__text">{t.about.paragraphs[1]}</p>
</PageShell>

<PageShell lang={lang} number={10} chapter="about">
  <p class="rubric">{c.vision}</p>
  <p class="statement">{framework.vision}</p>
  <h2 class="subhead">{c.mission}</h2>
  <ul class="ticks">
    {framework.mission.map((item) => <li>{item}</li>)}
  </ul>
</PageShell>

<PageShell lang={lang} number={11} chapter="about">
  <p class="rubric">{c.values}</p>
  <h2 class="page__title">{t.book.values}</h2>
  <ul class="entries entries--tight">
    {
      framework.values.map((value, index) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{num(index + 1, lang)}</span></span>
          <div>
            <h3 class="entry__title">{value.name}</h3>
            <p class="entry__text">{value.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</PageShell>

<PageShell lang={lang} number={12} chapter="about">
  <p class="rubric">{t.pages.about.nav}</p>
  <h2 class="page__title">{c.community}</h2>
  <div class="fleuron" aria-hidden="true" data-optional><Star variant="double" /></div>
  {framework.community.map((paragraph, index) => <p class:list={['page__text', { 'page__text--opening': index === 0 }]}>{paragraph}</p>)}
</PageShell>

<!-- ================= Programs: 13–16 ================= -->

<PageShell lang={lang} number={13} chapter="programs" kind="plate">
  <Plate lang={lang} chapter="programs" />
</PageShell>

<PageShell lang={lang} number={14} chapter="programs">
  <p class="rubric">{t.programs.eyebrow}</p>
  <h2 class="page__title">{t.programs.title}</h2>
  <ul class="entries">
    {
      programs.map((program) => (
        <li class="entry">
          <span class="entry__emblem" lang="ar" dir="rtl" aria-hidden="true">{program.emblem}</span>
          <div>
            <h3 class="entry__title">
              <a href={`#p-${firstPage(programChapter[program.id as keyof typeof programChapter])}`} data-goto>{program.name}</a>
            </h3>
            <p class="entry__text">{program.summary}</p>
            <p class="entry__note">{program.format} · {program.ages}</p>
          </div>
        </li>
      ))
    }
  </ul>
</PageShell>

<PageShell lang={lang} number={15} chapter="programs">
  <p class="rubric">{deeniyat.gloss}</p>
  <h2 class="page__title">{c.deeniyatBand.title}</h2>
  <p class="page__text">{c.deeniyatBand.text}</p>
  <ol class="numbered numbered--2">
    {deeniyat.subjects.map((subject) => <li>{subject.name}</li>)}
  </ol>
  <p class="page__actions" style="justify-content: center">
    <a class="btn btn--line" href={`#p-${firstPage('deeniyat')}`} data-goto>{c.deeniyatBand.link}</a>
  </p>
</PageShell>

<PageShell lang={lang} number={16} chapter="programs">
  <p class="rubric">{c.findProgram}</p>
  <h2 class="page__title">{t.book.begin}</h2>
  <ul class="entries">
    {
      alimiyah.divisions.map((division) => (
        <li class="entry">
          <span class="entry__ages">{num(division.ages, lang)}</span>
          <div>
            <h3 class="entry__title">{division.name}</h3>
            <p class="entry__text">{programs[0].short} · {programs[1].short} · {division.focus}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="page__aside" data-optional>{c.findProgramLead.replace(' As a guide:', '')}</p>
</PageShell>

<!-- ================= Nazirah: 17–22 ================= -->

<PageShell lang={lang} number={17} chapter="nazirah" kind="plate">
  <Plate lang={lang} chapter="nazirah" />
</PageShell>

<PageShell lang={lang} number={18} chapter="nazirah">
  <p class="rubric">{c.oneOnOne} · {programs[0].ages}</p>
  <h2 class="page__title">{t.pages.nazirah.heading}</h2>
  <p class="page__text page__text--opening">{nazirah.overview[0]}</p>
  <h3 class="subhead">{programs[0].lead.replace(':', '')}</h3>
  <ul class="ticks">
    {programs[0].points.map((point) => <li>{point}</li>)}
  </ul>
</PageShell>

{
  [
    { stages: nazirah.stages.slice(0, 3), number: 19 },
    { stages: nazirah.stages.slice(3), number: 20 },
  ].map(({ stages, number }) => (
    <PageShell lang={lang} number={number} chapter="nazirah">
      <p class="rubric">{c.stages}</p>
      <ol class="entries">
        {stages.map((stage) => (
          <li class="entry">
            <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{num(stage.number, lang)}</span></span>
            <div>
              <h3 class="entry__title">{stage.title}</h3>
              <p class="entry__text">{stage.outcome}</p>
            </div>
          </li>
        ))}
      </ol>
      {number === 20 && (
        <>
          <h3 class="subhead">{c.alongside}</h3>
          <p class="inline-list">{nazirah.extras.map((extra) => extra.title).join(' · ')}</p>
        </>
      )}
    </PageShell>
  ))
}

<PageShell lang={lang} number={21} chapter="nazirah">
  <p class="rubric">{c.stage} {num(3, lang)}</p>
  <h2 class="page__title">{nazirah.stages[2].title}</h2>
  <dl class="rows">
    {
      nazirah.stages[2].units.map((unit) => (
        <div>
          <dt>{unit.title}</dt>
          <dd>{unit.topics.slice(0, 4).join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</PageShell>

<PageShell lang={lang} number={22} chapter="nazirah">
  <p class="rubric">{c.outcomes}</p>
  <ul class="ticks ticks--tight">
    {nazirah.outcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>
  <p class="page__aside" data-optional>{nazirah.certification.note}</p>
</PageShell>

<!-- ================= Hifz: 23–28 ================= -->

<PageShell lang={lang} number={23} chapter="hifz" kind="plate">
  <Plate lang={lang} chapter="hifz" />
</PageShell>

<PageShell lang={lang} number={24} chapter="hifz">
  <p class="rubric">{c.oneOnOne} · {c.tracks}</p>
  <h2 class="page__title">{t.pages.hifz.heading}</h2>
  <p class="page__text">{hifz.overview[0]}</p>
  <ul class="entries">
    {
      hifz.tracks.map((track) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{track.letter}</span></span>
          <div>
            <h3 class="entry__title">{track.name}</h3>
            <p class="entry__note">{track.scope}</p>
            <p class="entry__text" data-optional>{track.points.slice(1, 4).join(' · ')}</p>
          </div>
        </li>
      ))
    }
  </ul>
</PageShell>

<PageShell lang={lang} number={25} chapter="hifz">
  <p class="rubric">{c.method}</p>
  <h2 class="page__title">{c.cycle}</h2>
  <ol class="entries">
    {
      hifz.cycle.map((part, index) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{num(index + 1, lang)}</span></span>
          <div>
            <h3 class="value__name">{part.term}<small>{part.name}</small></h3>
            <p class="entry__text">{part.items.slice(0, 3).join(' · ')}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="page__aside" data-optional>{c.cycleLead}</p>
</PageShell>

<PageShell lang={lang} number={26} chapter="hifz">
  <p class="rubric">{c.track} A · {hifz.tracks[0].name}</p>
  <h2 class="page__title">Four stages to the whole Qur’an</h2>
  <ol class="entries entries--tight">
    {
      hifz.stages.map((stage) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{num(stage.number, lang)}</span></span>
          <div>
            <h3 class="entry__title">{stage.title}</h3>
            <p class="entry__text">{stage.items.slice(0, 3).join(' · ')}</p>
          </div>
        </li>
      ))
    }
  </ol>
</PageShell>

<PageShell lang={lang} number={27} chapter="hifz">
  <p class="rubric">{c.track} B · {hifz.tracks[1].name}</p>
  <h2 class="page__title">{c.essentialSurahs}</h2>
  <p class="inline-list">{hifz.selected.essential.join(' · ')}</p>
  <h3 class="subhead">{c.longerSurahs}</h3>
  <p class="inline-list">{hifz.selected.longer.join(' · ')}</p>
  <p class="page__aside">{hifz.selected.portions}</p>
</PageShell>

<PageShell lang={lang} number={28} chapter="hifz">
  <p class="rubric">{c.outcomes}</p>
  <ul class="ticks">
    {hifz.outcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>
  <h3 class="subhead">{c.reports}</h3>
  <p class="inline-list">{hifz.assessment.reporting.slice(0, 5).join(' · ')}</p>
</PageShell>

<!-- ================= Alimiyah: 29–38 ================= -->

<PageShell lang={lang} number={29} chapter="alimiyah" kind="plate">
  <Plate lang={lang} chapter="alimiyah" />
</PageShell>

<PageShell lang={lang} number={30} chapter="alimiyah">
  <p class="rubric">{c.groupClasses}</p>
  <h2 class="page__title">{t.pages.alimiyah.heading}</h2>
  <p class="page__text">{alimiyah.philosophy[0]}</p>
  <ul class="entries entries--tight">
    {
      alimiyah.divisions.map((division) => (
        <li class="entry">
          <span class="entry__ages">{num(division.ages, lang)}</span>
          <div>
            <h3 class="entry__title">{division.name}</h3>
            <p class="entry__note">{division.structure}</p>
          </div>
        </li>
      ))
    }
  </ul>
</PageShell>

<PageShell lang={lang} number={31} chapter="alimiyah">
  <p class="rubric">{c.subjects}</p>
  <ol class="numbered">
    {alimiyah.subjects.map((subject) => <li>{subject}</li>)}
  </ol>
</PageShell>

<PageShell lang={lang} number={32} chapter="alimiyah">
  <p class="rubric">{c.ages} {num(alimiyah.divisions[0].ages, lang)}</p>
  <h2 class="page__title">{alimiyah.divisions[0].name}</h2>
  <p class="page__text">{first(junior.overview)}</p>
  <ol class="entries entries--tight">
    {
      junior.stages.map((stage) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{stage.letter}</span></span>
          <div>
            <h3 class="entry__title">{stage.name}</h3>
            <p class="entry__note">{c.ages} {num(stage.ages, lang)}</p>
            <p class="entry__text" data-optional>{stage.focus}</p>
          </div>
        </li>
      ))
    }
  </ol>
</PageShell>

<PageShell lang={lang} number={33} chapter="alimiyah">
  <p class="rubric">{alimiyah.divisions[0].name}</p>
  <dl class="rows">
    {
      junior.distribution.slice(0, 8).map((row) => (
        <div>
          <dt>{row.subject}</dt>
          <dd>{row.areas}</dd>
        </div>
      ))
    }
  </dl>
</PageShell>

<PageShell lang={lang} number={34} chapter="alimiyah">
  <p class="rubric">{c.ages} {num(alimiyah.divisions[1].ages, lang)}</p>
  <h2 class="page__title">{alimiyah.divisions[1].name}</h2>
  <p class="page__text">{first(youth.overview)}</p>
  <nav class="contents contents--tight" aria-label={c.pathway}>
    {
      youth.semesters.map((semester) => (
        <span class="contents__row">
          <span>{num(semester.number, lang)}. {semester.title}</span>
          <span class="contents__number">{semester.level}</span>
        </span>
      ))
    }
  </nav>
</PageShell>

<PageShell lang={lang} number={35} chapter="alimiyah">
  <p class="rubric">{c.finalProject}</p>
  <ul class="ticks ticks--tight">
    {youth.project.options.map((option) => <li>{option}</li>)}
  </ul>
  <p class="page__aside">{youth.project.note}</p>
</PageShell>

<PageShell lang={lang} number={36} chapter="alimiyah">
  <p class="rubric">{c.ages} {num(alimiyah.divisions[2].ages, lang)}</p>
  <h2 class="page__title">{alimiyah.divisions[2].name}</h2>
  <p class="page__text">{first(adult.overview[0])}</p>
  <nav class="contents contents--tight" aria-label={c.pathway}>
    {
      adult.semesters.map((semester) => (
        <span class="contents__row">
          <span>{num(semester.number, lang)}. {semester.title}</span>
          <span class="contents__number">{semester.level}</span>
        </span>
      ))
    }
  </nav>
</PageShell>

<PageShell lang={lang} number={37} chapter="alimiyah">
  <p class="rubric">{c.assessment}</p>
  <h2 class="page__title">{c.grading}</h2>
  <dl class="weights">
    {
      policies.grading.rows.map((row) => (
        <div style={`--weight: ${row.weight}`}>
          <dt>{row.component}</dt>
          <dd>{num(row.weight, lang)}%</dd>
        </div>
      ))
    }
  </dl>
  <p class="page__aside" data-optional>{policies.grading.intro}</p>
</PageShell>

<PageShell lang={lang} number={38} chapter="alimiyah">
  <p class="rubric">{c.certification}</p>
  {alimiyah.certification.policy.map((paragraph) => <p class="page__text">{paragraph}</p>)}
  <h3 class="subhead">{c.language}</h3>
  <p class="page__text" style="margin-top: 0.4em">{first(policies.language)}</p>
</PageShell>

<!-- ================= Deeniyat: 39–42 ================= -->

<PageShell lang={lang} number={39} chapter="deeniyat" kind="plate">
  <Plate lang={lang} chapter="deeniyat" />
</PageShell>

{
  [
    { subjects: deeniyat.subjects.slice(0, 4), number: 40 },
    { subjects: deeniyat.subjects.slice(4), number: 41 },
  ].map(({ subjects, number }) => (
    <PageShell lang={lang} number={number} chapter="deeniyat">
      <p class="rubric">{number === 40 ? t.pages.deeniyat.heading : deeniyat.gloss}</p>
      <ul class="entries entries--tight">
        {subjects.map((subject) => (
          <li class="entry">
            <span class="entry__emblem entry__emblem--small" lang="ar" dir="rtl" aria-hidden="true">{subject.emblem}</span>
            <div>
              <h3 class="value__name">{subject.name}<small>{subject.gloss}</small></h3>
              <p class="entry__text">{subject.units.filter((unit) => unit.title).slice(0, 4).map((unit) => unit.title).join(' · ') || subject.units[0].topics.slice(0, 3).join(' · ')}</p>
            </div>
          </li>
        ))}
      </ul>
    </PageShell>
  ))
}

<PageShell lang={lang} number={42} chapter="deeniyat">
  <p class="rubric">{c.byAge}</p>
  <dl class="rows">
    {
      deeniyat.ages.map((group) => (
        <div>
          <dt>{group.title}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
  <p class="page__aside">{hifz.method.deeniyat[0]}, alongside the Hifz lessons.</p>
</PageShell>

<!-- ================= Academics: 43–48 ================= -->

<PageShell lang={lang} number={43} chapter="academics" kind="plate">
  <Plate lang={lang} chapter="academics" />
</PageShell>

<PageShell lang={lang} number={44} chapter="academics">
  <p class="rubric">{c.philosophy}</p>
  <h2 class="page__title">Four principles behind every lesson</h2>
  <ol class="entries entries--tight">
    {
      framework.philosophy.principles.map((principle, index) => (
        <li class="entry">
          <span class="entry__mark entry__mark--number"><Star variant="line" /><span>{num(index + 1, lang)}</span></span>
          <div>
            <h3 class="value__name">{principle.name}</h3>
            <p class="entry__text">{principle.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</PageShell>

<PageShell lang={lang} number={45} chapter="academics">
  <p class="rubric">{c.teaching}</p>
  <p class="page__text">{framework.teaching.intro}</p>
  <ul class="ticks">
    {framework.teaching.points.map((point) => <li>{point}</li>)}
  </ul>
  <p class="page__aside" data-optional>{framework.teaching.note}</p>
</PageShell>

<PageShell lang={lang} number={46} chapter="academics">
  <p class="rubric">{c.assessmentProgress}</p>
  <ul class="ticks">

---
import { khatam } from '../lib/geometry';

/** The eight-pointed star (khatam), filled or drawn as an outline. */
interface Props {
  variant?: 'solid' | 'line' | 'double';
  class?: string;
}

const { variant = 'solid', class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
  fill={variant === 'solid' ? 'currentColor' : 'none'}
  stroke={variant === 'solid' ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linejoin="round"
>
  <polygon points={khatam(24, 24, 22)} />
  {variant === 'double' && <polygon points={khatam(24, 24, 10, 22.5)} fill="currentColor" stroke="none" />}
</svg>

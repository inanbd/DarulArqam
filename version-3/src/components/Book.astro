---
import BookPages from './BookPages.astro';
import Rosette from './Rosette.astro';
import Star from './Star.astro';
import { arabic, getDict, type Lang } from '../i18n';
import { chapters, lastPage } from '../lib/chapters';

/**
 * The book. The markup below is a plain list of "faces" in reading order:
 * the cover, an endpaper, the half-title, the numbered pages, an endpaper.
 * The script at the bottom binds them into leaves and turns them on scroll.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);

// Handed to the script as a data attribute.
const settings = {
  digits: lang === 'bn' ? 'bn' : 'latn',
  lastPage,
  cover: t.book.cover,
  brand: t.brand.name,
  chapters: chapters.map((chapter) => ({ id: chapter.id, name: t.pages[chapter.id].nav })),
};
---

<div class="book-track is-closed" data-book-track data-settings={JSON.stringify(settings)}>
  <div class="stage" data-stage>
    <div class="desk" aria-hidden="true"><span class="desk__lattice"><span class="pattern"></span></span></div>

    <div class="book" data-book>
      <div class="book__block book__block--left" aria-hidden="true"></div>
      <div class="book__block book__block--right" aria-hidden="true"></div>
      <div class="book__leaves" data-leaves></div>

      <div class="book__flow" data-flow>
        <div class="face cover" data-cover>
          <div class="cover__inner">
            <span class="cover__frame" aria-hidden="true"></span>
            <div class="cover__medallion">
              <Rosette />
              <p class="cover__arabic gilt" lang="ar" dir="rtl">{arabic.name}</p>
            </div>
            <p class="cover__name gilt">{t.brand.name}</p>
            <p class="cover__tagline">{t.brand.tagline}</p>
          </div>
        </div>

        <div class="face endpaper" data-endpaper aria-hidden="true"><span class="pattern"></span></div>

        <section class="face page page--half" data-half aria-label={t.brand.name}>
          <div class="page__inner">
            <span class="page__frame" aria-hidden="true"></span>
            <span></span>
            <div class="page__body" data-fit>
              <div class="half">
                <p class="half__bismillah" lang="ar" dir="rtl">{arabic.bismillah}</p>
                <Star variant="double" class="half__mark" />
                <p class="half__name">{t.brand.name}</p>
                <p class="half__tagline">{t.book.established}</p>
              </div>
            </div>
            <span></span>
          </div>
        </section>

        <BookPages lang={lang} />

        <div class="face endpaper" data-endpaper aria-hidden="true"><span class="pattern"></span></div>
      </div>

      <div class="book__cast book__cast--left" aria-hidden="true"></div>
      <div class="book__cast book__cast--right" aria-hidden="true"></div>
      <div class="book__spine" aria-hidden="true"></div>
    </div>

    <p class="hint" aria-hidden="true">
      {t.book.open}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
    </p>

    <div class="controls" data-controls>
      <button class="controls__button" type="button" data-previous aria-label={t.book.previous} title={t.book.previous}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <div class="controls__where">
        <p class="controls__label" data-where aria-live="polite"></p>
        <div class="controls__thread" aria-hidden="true"><span></span></div>
      </div>
      <button class="controls__button" type="button" data-next aria-label={t.book.next} title={t.book.next}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  /*
    The book engine.

    Three views:
      spread  two pages side by side; each leaf carries a page on its front and its back
      single  one page at a time, for narrow screens; each leaf carries one page
      flat    no book: the pages as a plain column (small screens, reduced motion,
              "plain view", or a page that will not fit its sheet)

    In the book views the stage is pinned and a tall track gives the scroll its
    length: one "step" of scrolling turns one leaf. The position on screen eases
    toward the scroll position, which is what keeps the turning smooth, and when
    the scrolling stops the book settles on the nearest whole page.
  */

  type View = 'spread' | 'single' | 'flat';

  interface Leaf {
    element: HTMLElement;
    faces: HTMLElement[];
    /** A veil over each face that darkens while the leaf is in the air. */
    shades: HTMLElement[];
    /** How far this leaf has turned: 0 lying on the right, 1 turned over. */
    turned: number;
  }

  // The clocks come first, so that their page is measured with them showing.
  startClocks();

  const track = document.querySelector<HTMLElement>('[data-book-track]');
  if (track) startBook(track);

  /** Shows the visitor's own time next to the time in Dhaka, and keeps both current. */
  function startClocks() {
    document.querySelectorAll<HTMLElement>('[data-clock]').forEach((panel) => {
      try {
        const locale = panel.dataset.locale ?? 'en-US';
        const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const time = (timeZone: string) => new Intl.DateTimeFormat(locale, { hour: 'numeric', minute: '2-digit', timeZone });
        const day = (timeZone: string) => new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone });
        const formats = {
          '[data-clock-local]': time(zone),
          '[data-clock-dhaka]': time('Asia/Dhaka'),
          '[data-clock-zone]': day(zone),
          '[data-clock-day]': day('Asia/Dhaka'),
        };
        const tick = () => {
          const now = new Date();
          for (const [selector, format] of Object.entries(formats)) {
            const element = panel.querySelector(selector);
            if (element) element.textContent = format.format(now);
          }
        };
        tick();
        panel.hidden = false;
        window.setInterval(tick, 15_000);
      } catch {
        // Without time-zone support the explanation alone is enough.
      }
    });
  }

  function startBook(track: HTMLElement) {
    const root = document.documentElement;
    const stage = track.querySelector<HTMLElement>('[data-stage]')!;
    const book = track.querySelector<HTMLElement>('[data-book]')!;
    const flow = track.querySelector<HTMLElement>('[data-flow]')!;
    const leavesBox = track.querySelector<HTMLElement>('[data-leaves]')!;
    const where = track.querySelector<HTMLElement>('[data-where]')!;
    const previous = track.querySelector<HTMLButtonElement>('[data-previous]')!;
    const next = track.querySelector<HTMLButtonElement>('[data-next]')!;
    // The parts that move or fade every frame. Their styles are set directly, on
    // these few elements, so that a frame never restyles the pages themselves.
    const parts = {
      castLeft: track.querySelector<HTMLElement>('.book__cast--left')!,
      castRight: track.querySelector<HTMLElement>('.book__cast--right')!,
      spine: track.querySelector<HTMLElement>('.book__spine')!,
      blockLeft: track.querySelector<HTMLElement>('.book__block--left')!,
      blockRight: track.querySelector<HTMLElement>('.book__block--right')!,
      hint: track.querySelector<HTMLElement>('.hint')!,
      controls: track.querySelector<HTMLElement>('[data-controls]')!,
      thread: track.querySelector<HTMLElement>('.controls__thread span')!,
    };
    const settings = JSON.parse(track.dataset.settings ?? '{}') as {
      digits: string;
      lastPage: number;
      cover: string;
      brand: string;
      chapters: { id: string; name: string }[];
    };

    /** Every face in reading order, as written in the page. */
    const faces = Array.from(flow.children) as HTMLElement[];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const PLAIN_KEY = 'darul-arqam-plain-view';

    let view: View = 'flat';
    let leaves: Leaf[] = [];
    /** For each face: the scroll step at which it is the one being read. */
    let restingStep = new Map<HTMLElement, number>();
    let turns = 0; // how many leaves can turn
    let step = 1; // pixels of scrolling per turn
    let trackTop = 0;
    let target = 0; // where the scroll says we are, in turns
    let shown = 0; // where the book on screen is, easing toward target
    let frame = 0;
    let lastTime = 0;
    let lastScroll = window.scrollY;
    let direction = 1;
    let touching = false;
    let settleTimer = 0;
    let builtWidth = 0;
    /** Window sizes at which the pages did not fit their sheets. */
    const tooSmall = new Set<string>();

    const clamp = (value: number, low: number, high: number) => Math.min(high, Math.max(low, value));
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const sizeKey = () => `${window.innerWidth}x${window.innerHeight}`;
    const plainChosen = () => {
      try {
        return window.sessionStorage.getItem(PLAIN_KEY) === '1';
      } catch {
        return false;
      }
    };
    const digits = (value: number | string) =>
      settings.digits === 'bn' ? String(value).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]) : String(value);

    /** Which view this window calls for. */
    function wantedView(): View {
      if (plainChosen() || reducedMotion.matches || tooSmall.has(sizeKey())) return 'flat';
      const width = window.innerWidth;
      const height = window.innerHeight;
      if (width >= 960 && height >= 560) return 'spread';
      if (width >= 340 && width < 960 && height >= 540) return 'single';
      return 'flat';
    }

    /** Puts every face back in the plain list, in reading order. */
    function unbind() {
      for (const face of faces) {
        face.classList.remove('page--tight');
        face.style.removeProperty('--fit');
        face.removeAttribute('inert');
        face.querySelector(':scope > .shade')?.remove();
        flow.appendChild(face);
      }
      leavesBox.replaceChildren();
      leaves = [];
      restingStep = new Map();
      rested = -1;
      described = -1;
      book.style.removeProperty('transform');
      for (const part of Object.values(parts)) {
        part.style.removeProperty('opacity');
        part.style.removeProperty('transform');
        part.style.removeProperty('--read');
      }
    }

    /** Binds the faces into leaves for a book view. */
    function bind(kind: 'spread' | 'single') {
      const sequence = kind === 'spread' ? faces : faces.filter((face) => !face.hasAttribute('data-endpaper'));
      const perLeaf = kind === 'spread' ? 2 : 1;

      for (let index = 0; index < sequence.length; index += perLeaf) {
        const front = sequence[index];
        const back = kind === 'spread' ? sequence[index + 1] : blankSide();
        const element = document.createElement('div');
        element.className = front.hasAttribute('data-cover') ? 'leaf leaf--cover' : 'leaf';
        element.append(front, back);
        leavesBox.appendChild(element);

        const shades = [front, back].map((face) => {
          const shade = document.createElement('span');
          shade.className = 'shade';
          shade.setAttribute('aria-hidden', 'true');
          face.appendChild(shade);
          return shade;
        });

        const leafIndex = leaves.length;
        leaves.push({ element, faces: [front, back], shades, turned: -1 });
        // A front is read when its own leaf lies on top of the right-hand pile;
        // a back is read once that leaf has turned over.
        restingStep.set(front, leafIndex);
        if (kind === 'spread') restingStep.set(back, leafIndex + 1);
      }
      turns = leaves.length - 1;
    }

    function blankSide() {
      const blank = document.createElement('div');
      blank.className = 'face blank';
      blank.setAttribute('aria-hidden', 'true');
      return blank;
    }

    /**
     * Makes sure no page is too full for its sheet. A full page is first set in
     * slightly smaller type; if that is not enough its optional details are
     * dropped and the type is set smaller still. Returns false if a page still
     * does not fit, in which case the plain view is used instead.
     */
    function fitPages(): boolean {
      const bodies = Array.from(leavesBox.querySelectorAll<HTMLElement>('[data-fit]'));
      const overflows = (body: HTMLElement) => body.scrollHeight > body.clientHeight + 1;
      const shrink = (page: HTMLElement, body: HTMLElement, smallest: number) => {
        let fit = 1;
        page.style.removeProperty('--fit');
        while (overflows(body) && fit > smallest) {
          fit = Math.round((fit - 0.02) * 100) / 100;
          page.style.setProperty('--fit', String(fit));
        }
        return !overflows(body);
      };

      for (const body of bodies) {
        const page = body.closest<HTMLElement>('.page')!;
        page.classList.remove('page--tight');
        page.style.removeProperty('--fit');
        if (!overflows(body)) continue;
        if (shrink(page, body, 0.9)) continue;
        page.classList.add('page--tight');
        if (!shrink(page, body, 0.82)) return false;
      }
      return true;
    }

    /** Works out the length of the scroll and where it starts. */
    function measure() {
      if (view === 'flat') {
        track.style.removeProperty('height');
        return;
      }
      const stageHeight = stage.offsetHeight;
      step = Math.round(stageHeight * (view === 'spread' ? 0.62 : 0.5));
      track.style.height = `${turns * step + stageHeight}px`;
      trackTop = track.getBoundingClientRect().top + window.scrollY;
    }

    /** The face being read right now, so the place can be kept when the view changes. */
    function currentFace(): HTMLElement | undefined {
      if (view === 'flat') return undefined;
      const at = Math.round(target);
      let found: HTMLElement | undefined;
      restingStep.forEach((value, face) => {
        if (value === at && !found && !face.hasAttribute('data-endpaper')) found = face;
      });
      return found;
    }

    /** Builds, or rebuilds, the view the window calls for. */
    function build() {
      const keep = currentFace();
      const wanted = wantedView();

      unbind();
      view = wanted;
      root.dataset.book = view;
      builtWidth = window.innerWidth;

      if (view !== 'flat') {
        bind(view);
        if (!fitPages()) {
          // The pages need more room than this window has.
          tooSmall.add(sizeKey());
          unbind();
          view = 'flat';
          root.dataset.book = view;
        }
      }

      measure();
      updatePlainButtons();

      if (view === 'flat') {
        window.cancelAnimationFrame(frame);
        frame = 0;
        if (keep) keep.scrollIntoView({ block: 'start', behavior: 'instant' });
        return;
      }

      if (keep && restingStep.has(keep)) {
        window.scrollTo({ top: trackTop + restingStep.get(keep)! * step, behavior: 'instant' });
      }
      readScroll();
      shown = target;
      for (const leaf of leaves) leaf.turned = -1;
      draw();
    }

    /** Reads the scroll position into `target`. */
    function readScroll() {
      const y = window.scrollY;
      if (y !== lastScroll) direction = y > lastScroll ? 1 : -1;
      lastScroll = y;
      target = clamp((y - trackTop) / step, 0, turns);
    }

    /** Draws the book at `shown`. */
    function draw() {
      const count = leaves.length;
      const base = Math.floor(shown);
      const resting = Math.round(shown);
      const fullTurn = view === 'spread' ? -180 : -118;

      for (let index = 0; index < count; index++) {
        const leaf = leaves[index];
        const turned = clamp(shown - index, 0, 1);
        const near = index >= base - 1 && index <= base + 2;
        if (turned === leaf.turned && !near) continue;
        leaf.turned = turned;

        const style = leaf.element.style;
        const eased = smooth(turned);
        const moving = turned > 0 && turned < 1;

        style.transform = `perspective(var(--persp)) rotateY(${(fullTurn * eased).toFixed(3)}deg)`;
        // One page at a time: the sheet swings away to the left and fades as it goes.
        if (view === 'single') style.opacity = (1 - clamp((turned - 0.5) / 0.42, 0, 1)).toFixed(3);
        const shade = (Math.sin(Math.PI * eased) * 0.9).toFixed(3);
        leaf.shades[0].style.opacity = shade;
        leaf.shades[1].style.opacity = shade;
        // Turned leaves pile up on the left with the latest on top; the rest
        // wait on the right with the next on top; a leaf in the air is above both.
        style.zIndex = String(moving ? 1000 : turned >= 1 ? index + 1 : count - index);
        style.visibility = near ? 'visible' : 'hidden';
        leaf.element.classList.toggle('is-near', near);
        // Only the pages being read take clicks and keyboard focus.
        leaf.faces[0].toggleAttribute('inert', index !== resting);
        if (view === 'spread') leaf.faces[1].toggleAttribute('inert', index !== resting - 1);
      }

      const eased = smooth(shown - base);
      const lift = Math.sin(Math.PI * eased);
      const opening = smooth(clamp(shown, 0, 1));
      const read = shown / Math.max(turns, 1);

      // Closed, the book sits in the middle of the desk; it moves over as the cover opens.
      if (view === 'spread') book.style.transform = `translateX(calc(var(--page-w) * ${(-0.5 * (1 - opening)).toFixed(4)}))`;
      parts.castRight.style.opacity = (lift * (1 - eased) * 0.9).toFixed(3);
      parts.castLeft.style.opacity = (lift * eased * 0.9).toFixed(3);
      parts.spine.style.opacity = opening.toFixed(3);
      parts.blockLeft.style.opacity = shown >= 0.999 ? '1' : '0';
      // The hint leaves during the first half of the opening and the controls
      // arrive during the second, so the two never show at once.
      parts.hint.style.opacity = (1 - smooth(clamp(shown * 2, 0, 1))).toFixed(3);
      parts.controls.style.opacity = smooth(clamp(shown * 2 - 1, 0, 1)).toFixed(3);
      parts.thread.style.transform = `scaleX(${read.toFixed(4)})`;

      if (resting !== rested) {
        rested = resting;
        // The slivers of page edges on either side change only when a page lands.
        const share = String(resting / Math.max(turns, 1));
        parts.blockLeft.style.setProperty('--read', share);
        parts.blockRight.style.setProperty('--read', share);
        track.classList.toggle('is-closed', resting < 1);
        describe(resting);
      }
    }

    let rested = -1;
    let described = -1;

    /** Says where the reader is: the chapter and the page numbers on show. */
    function describe(at: number) {
      if (at === described) return;
      described = at;
      const visible: HTMLElement[] = [];
      restingStep.forEach((value, face) => {
        if (value === at) visible.push(face);
      });
      const pages = visible
        .map((face) => Number(face.dataset.page))
        .filter((number) => number > 0)
        .sort((a, b) => a - b);
      const chapterId = visible.map((face) => face.dataset.chapter).filter(Boolean).pop();
      const chapter = settings.chapters.find((entry) => entry.id === chapterId);

      where.textContent =
        pages.length === 0
          ? at === 0
            ? settings.cover
            : settings.brand
          : `${chapter ? `${chapter.name} · ` : ''}${pages.map(digits).join('–')} / ${digits(settings.lastPage)}`;
      previous.disabled = at <= 0;
      next.disabled = at >= turns;

      document.querySelectorAll<HTMLElement>('[data-chapter-link]').forEach((link) => {
        if (link.dataset.chapterLink === chapterId) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    }

    /** Eases `shown` toward `target`, one frame at a time, until it arrives. */
    function animate(time: number) {
      const elapsed = Math.min(64, time - (lastTime || time));
      lastTime = time;
      const gap = target - shown;
      if (Math.abs(gap) < 0.0006) {
        shown = target;
        draw();
        frame = 0;
        lastTime = 0;
        return;
      }
      shown += gap * (1 - Math.exp(-elapsed / 105));
      draw();
      frame = window.requestAnimationFrame(animate);
    }

    function wake() {
      if (!frame) frame = window.requestAnimationFrame(animate);
    }

    /** Once the scrolling stops, comes to rest on a whole page. */
    function settle() {
      if (view === 'flat' || touching) return;
      const y = window.scrollY;
      if (y <= trackTop || y >= trackTop + turns * step - 1) return;
      const whole = Math.floor(target);
      const part = target - whole;
      if (part < 0.01 || part > 0.99) return;
      // A small push in either direction is enough to turn the page.
      const goal = direction > 0 ? (part > 0.12 ? whole + 1 : whole) : part < 0.88 ? whole : whole + 1;
      window.scrollTo({ top: trackTop + goal * step, behavior: 'smooth' });
    }

    /**
     * Turns to a place in the book. Nearby, the pages turn one by one; from far
     * away the book opens close to the place and only the last few pages turn,
     * which is quicker and stays smooth.
     */
    function goTo(index: number) {
      const goal = clamp(index, 0, turns);
      const top = trackTop + goal * step;
      if (Math.abs(goal - shown) <= 3) {
        window.scrollTo({ top, behavior: 'smooth' });
        return;
      }
      shown = goal - Math.sign(goal - shown) * 2.4;
      window.scrollTo({ top, behavior: 'instant' });
      readScroll();
      wake();
    }

    function onScroll() {
      if (view === 'flat') return;
      readScroll();
      wake();
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 140);
    }

    // ----- Plain view on request -----

    function updatePlainButtons() {
      const plain = plainChosen();
      // Where the book cannot be shown at all, there is nothing to switch to.
      const possible = plain || view !== 'flat';
      document.querySelectorAll<HTMLButtonElement>('[data-plain-toggle]').forEach((button) => {
        button.hidden = !possible;
        button.textContent = (plain ? button.dataset.bookLabel : button.dataset.plainLabel) ?? '';
        button.title = (plain ? button.dataset.bookTitle : button.dataset.plainTitle) ?? '';
        button.setAttribute('aria-pressed', String(plain));
      });
    }

    document.addEventListener('click', (event) => {
      const origin = event.target as HTMLElement;

      if (origin.closest('[data-plain-toggle]')) {
        try {
          if (plainChosen()) window.sessionStorage.removeItem(PLAIN_KEY);
          else window.sessionStorage.setItem(PLAIN_KEY, '1');
        } catch {
          return;
        }
        build();
        if (view !== 'flat') window.scrollTo({ top: trackTop, behavior: 'instant' });
        return;
      }

      // Links to a page of the book turn to it instead of jumping.
      const link = origin.closest<HTMLAnchorElement>('a[data-goto]');
      if (link && view !== 'flat') {
        const face = document.getElementById(link.hash.slice(1));
        if (face && restingStep.has(face)) {
          event.preventDefault();
          goTo(restingStep.get(face)!);
        }
      }
    });

    previous.addEventListener('click', () => goTo(Math.round(target) - 1));
    next.addEventListener('click', () => goTo(Math.round(target) + 1));

    document.addEventListener('keydown', (event) => {
      if (view === 'flat' || event.altKey || event.ctrlKey || event.metaKey) return;
      const focused = document.activeElement;
      if (focused && /^(INPUT|TEXTAREA|SELECT)$/.test(focused.tagName)) return;
      const y = window.scrollY;
      if (y < trackTop - 1 || y > trackTop + turns * step + 1) return;
      if (event.key === 'ArrowRight') goTo(Math.round(target) + 1);
      else if (event.key === 'ArrowLeft') goTo(Math.round(target) - 1);
      else return;
      event.preventDefault();
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('touchstart', () => (touching = true), { passive: true });
    window.addEventListener(
      'touchend',
      () => {
        touching = false;
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(settle, 180);
      },
      { passive: true },
    );

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        // On phones the address bar comes and goes and only the height changes;
        // that is no reason to rebind the book.
        if (wantedView() !== view || window.innerWidth !== builtWidth) build();
        else if (view !== 'flat') {
          measure();
          onScroll();
        }
      }, 160);
    });
    reducedMotion.addEventListener('change', build);

    build();
    // Sheets are measured with the real fonts, so measure again once they are in.
    document.fonts?.ready.then(() => {
      tooSmall.clear();
      build();
    });
  }
</script>

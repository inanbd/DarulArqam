---
import { khatam, polygon } from '../lib/geometry';

/** A sixteen-pointed rosette woven from turned squares, for the cover and the seal. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const outer = [0, 22.5, 45, 67.5].map((rotation) => polygon(200, 200, 178, 4, rotation));
const inner = [0, 22.5, 45, 67.5].map((rotation) => polygon(200, 200, 124, 4, rotation));
---

<svg class={className} viewBox="0 0 400 400" aria-hidden="true" focusable="false" fill="none" stroke="currentColor">
  <circle cx="200" cy="200" r="197" stroke-width="1.6"></circle>
  <circle cx="200" cy="200" r="188" stroke-width="0.8" stroke-dasharray="1 7" stroke-linecap="round"></circle>
  <g stroke-width="1.4">{outer.map((points) => <polygon points={points} />)}</g>
  <g stroke-width="0.9" opacity="0.85">{inner.map((points) => <polygon points={points} />)}</g>
  <polygon points={khatam(200, 200, 96)} stroke-width="1.2"></polygon>
</svg>

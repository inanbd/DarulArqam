---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';
import Shamsa from './Shamsa.astro';
import { site } from '../config/site';
import { getDict, published, type Lang } from '../i18n';
import { menu, pageHref, type PageId } from '../lib/routes';

interface Props {
  lang: Lang;
  page?: PageId;
}

const { lang, page } = Astro.props;
const t = getDict(lang);
// The language switch shows only when the site is published in a second language.
const other = published.find((code) => code !== lang);
const otherLabel: Record<Lang, string> = { en: 'English', bn: 'বাংলা' };
const { whatsappNumber, whatsappDisplay } = site.contact;
---

<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__note">
      <Shamsa size={12} />
      {t.common.topbar}
    </p>
    <div class="topbar__links">
      {
        whatsappNumber && (
          <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener">
            <Icon name="chat" size={15} />
            {whatsappDisplay}
          </a>
        )
      }
      {
        other && (
          <a href={pageHref(other, page ?? 'home')} lang={other} hreflang={other}>
            <Icon name="globe" size={15} />
            {otherLabel[other]}
          </a>
        )
      }
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={pageHref(lang, 'home')} aria-label={`${t.brand.name} — ${t.brand.tagline}`}>
      <Logo size={52} variant="color" />
      <span class="brand__text">
        <span class="brand__name"><Wordmark height={20} /></span>
        <span class="brand__tagline">{t.brand.tagline}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">{t.nav.menu}</span>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="nav" id="site-nav" aria-label={t.nav.label}>
      <ul class="nav__links">
        {
          menu.map((entry) => {
            const open = entry.page === page || (entry.under ?? []).includes(page as PageId);
            return (
              <li class:list={{ 'has-sub': entry.under }}>
                <a href={pageHref(lang, entry.page)} aria-current={entry.page === page ? 'page' : open ? 'true' : undefined}>
                  {t.pages[entry.page].nav}
                  {entry.under && (
                    <svg class="nav__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M1 1l4 4 4-4" />
                    </svg>
                  )}
                </a>
                {entry.under && (
                  <ul class="nav__sub">
                    {entry.under.map((id) => (
                      <li>
                        <a href={pageHref(lang, id)} aria-current={id === page ? 'page' : undefined}>
                          {t.pages[id].nav}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
      <a class="btn btn--saffron btn--sm nav__cta" href={pageHref(lang, 'trial')} aria-current={page === 'trial' ? 'page' : undefined}>
        {t.nav.cta}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (header && toggle) {
    const close = () => {
      header.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 48);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  /* ----- Top bar ----- */

  .topbar {
    background: var(--navy-900);
    color: var(--on-dark-soft);
    font-size: 0.86rem;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.5rem;
  }

  .topbar__note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1.4;
  }

  .topbar__note :global(svg) {
    flex-shrink: 0;
    color: var(--saffron-400);
  }

  .topbar__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .topbar__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.45rem;
    color: var(--on-dark);
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }

  .topbar__links a:hover {
    color: var(--saffron-400);
  }

  .topbar__links :global(svg) {
    color: var(--saffron-400);
  }

  /* ----- Main bar ----- */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 248, 244, 0.92);
    border-bottom: 1px solid transparent;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    border-bottom-color: var(--sand-200);
    box-shadow: 0 14px 30px -26px rgba(23, 41, 35, 0.6);
  }

  .site-header.is-open {
    background: var(--paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .brand__text {
    display: grid;
    line-height: 1.1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--teal-600);
  }

  .brand__tagline {
    margin-top: 0.2rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal-700);
  }

  :global(html[lang='bn']) .brand__tagline {
    font-size: 0.82rem;
    letter-spacing: 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .nav__links {
    display: flex;
    gap: clamp(0.15rem, 0.8vw, 0.6rem);
  }

  .nav__links a {
    position: relative;
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: 0.7rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink-soft);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .nav__links a:hover {
    color: var(--navy-900);
    background: var(--sand-100);
  }

  .nav__links > li > a[aria-current] {
    color: var(--navy-900);
  }

  /* The current page is marked with a small turquoise bar. */
  .nav__links > li > a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.1rem;
    height: 3px;
    border-radius: 3px;
    background: var(--teal-500);
  }

  .nav__links > li {
    position: relative;
  }

  .nav__links > li > a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav__caret {
    color: var(--teal-600);
  }

  /* The program pages open beneath "Programs". */
  .nav__sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 5;
    display: none;
    min-width: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--sand-200);
    border-radius: var(--radius-sm);
    background: #fff;
    box-shadow: var(--shadow-lift);
  }

  .has-sub:hover .nav__sub,
  .has-sub:focus-within .nav__sub {
    display: block;
  }

  .nav__sub a {
    padding: 0.55rem 0.8rem;
  }

  .nav__sub a[aria-current='page'] {
    color: var(--teal-700);
    background: var(--teal-50);
  }

  .nav-toggle {
    display: none;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0;
    border: 1px solid var(--sand-300);
    border-radius: 0.9rem;
    background: #fff;
    cursor: pointer;
  }

  .nav-toggle__bars {
    display: grid;
    gap: 5px;
    width: 1.15rem;
    margin-inline: auto;
  }

  .nav-toggle__bars span {
    height: 2px;
    border-radius: 2px;
    background: var(--navy-900);
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .is-open .nav-toggle__bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .is-open .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }

  .is-open .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 72rem) {
    .site-header__inner {
      min-height: 4.5rem;
    }

    .nav-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 0.75rem var(--gutter) 1.75rem;
      background: var(--paper);
      border-bottom: 1px solid var(--sand-200);
      box-shadow: 0 30px 40px -30px rgba(23, 41, 35, 0.5);
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }

    .is-open .nav {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__links a {
      padding: 0.95rem 0.25rem;
      border-radius: 0;
      border-bottom: 1px solid var(--sand-200);
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--navy-900);
    }

    .nav__links a:hover {
      background: none;
    }

    .nav__links a[aria-current] {
      color: var(--teal-700);
    }

    .nav__links > li > a[aria-current]::after {
      display: none;
    }

    .nav__caret {
      display: none;
    }

    .nav__sub {
      position: static;
      display: block;
      min-width: 0;
      padding: 0 0 0 1.25rem;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .nav__sub a {
      font-family: var(--font-body);
      font-size: 1.02rem;
      font-weight: 600;
      color: var(--ink-soft);
    }

    .nav__sub a[aria-current='page'] {
      background: none;
    }

    .nav__cta {
      padding-block: 0.9rem;
      font-size: 1rem;
    }

    /* Without scripts the menu button cannot open anything, so show the links. */
    :global(.no-js) .nav-toggle {
      display: none;
    }

    :global(.no-js) .site-header {
      position: static;
    }

    :global(.no-js) .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }

    :global(.no-js) .nav {
      position: static;
      display: flex;
      width: 100%;
      padding: 0 0 1rem;
      border: 0;
      box-shadow: none;
    }
  }

  @media (max-width: 46rem) {
    .topbar__note {
      display: none;
    }

    .topbar__links {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

---
import Icon from './Icon.astro';
import { getDict, type Lang } from '../i18n';

/** Explains the time difference, with the visitor's time beside the time in Dhaka. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<div class="timeband on-dark" data-reveal data-clock data-locale={lang === 'bn' ? 'bn-BD' : 'en-US'}>
  <span class="pattern pattern--corner"></span>
  <div class="timeband__copy">
    <span class="icon-tile icon-tile--saffron">
      <Icon name="globe" size={24} />
    </span>
    <h3 class="timeband__title">{t.how.time.title}</h3>
    <p class="timeband__text">{t.how.time.text}</p>
    <p class="timeband__zones">{t.how.time.zones}</p>
  </div>
  <div class="timeband__clocks" aria-hidden="true" hidden data-clock-panel>
    <div class="clock">
      <span class="clock__label">{t.how.time.yours}</span>
      <span class="clock__time" data-clock-local>--:--</span>
      <span class="clock__day" data-clock-zone></span>
    </div>
    <div class="clock clock--dhaka">
      <span class="clock__label">{t.how.time.dhaka}</span>
      <span class="clock__time" data-clock-dhaka>--:--</span>
      <span class="clock__day" data-clock-day></span>
    </div>
  </div>
</div>

<script>
  // Shows the visitor's own time next to the time in Dhaka, and keeps both current.
  document.querySelectorAll<HTMLElement>('[data-clock]').forEach((band) => {
    const panel = band.querySelector<HTMLElement>('[data-clock-panel]');
    if (!panel) return;
    try {
      const locale = band.dataset.locale ?? 'en-US';
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const time = (timeZone: string) => new Intl.DateTimeFormat(locale, { hour: 'numeric', minute: '2-digit', timeZone });
      const day = (timeZone: string) => new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone });
      const formats = {
        '[data-clock-local]': time(zone),
        '[data-clock-dhaka]': time('Asia/Dhaka'),
        '[data-clock-zone]': day(zone),
        '[data-clock-day]': day('Asia/Dhaka'),
      };
      const tick = () => {
        const now = new Date();
        for (const [selector, format] of Object.entries(formats)) {
          const element = panel.querySelector(selector);
          if (element) element.textContent = format.format(now);
        }
      };
      tick();
      panel.hidden = false;
      window.setInterval(tick, 15_000);
    } catch {
      // Without time-zone support the explanation alone is enough.
    }
  });
</script>

<style>
  .timeband {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 90% at 100% 0%, rgba(8, 124, 89, 0.7), transparent 70%),
      linear-gradient(140deg, var(--navy-800), var(--navy-950));
    color: var(--on-dark);
    box-shadow: var(--shadow-lift);
  }

  .timeband .pattern {
    z-index: -1;
    --pattern-color: #8fd8b8;
    --pattern-opacity: 0.3;
  }

  .timeband__title {
    margin-top: 1.25rem;
    font-size: calc(clamp(1.6rem, 1.4vw + 1.1rem, 2.1rem) * var(--display-scale));
    color: #fff;
  }

  .timeband__text {
    margin-top: 0.75rem;
    max-width: 36rem;
    color: var(--on-dark-soft);
  }

  .timeband__zones {
    margin-top: 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--saffron-400);
  }

  .timeband__clocks {
    display: grid;
    gap: 0.9rem;
  }

  .timeband__clocks[hidden] {
    display: none;
  }

  .clock {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.1rem 1rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.07);
  }

  .clock--dhaka {
    border-color: rgba(214, 182, 109, 0.5);
    background: rgba(214, 182, 109, 0.1);
  }

  .clock__label {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--saffron-400);
  }

  :global(html[lang='bn']) .clock__label {
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .clock__time {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
    white-space: nowrap;
  }

  .clock__day {
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }

  @media (max-width: 56rem) {
    .timeband {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 26rem) {
    .clock__time {
      font-size: 1.7rem;
    }
  }
</style>

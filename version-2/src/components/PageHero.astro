---
import AyahCard from './AyahCard.astro';
import { getDict, type Lang } from '../i18n';
import { pageHref, type PageId } from '../lib/routes';

/** The top of every inner page: where you are, the heading, and the page's verse. */
interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = getDict(lang);
const meta = t.pages[page];
---

<section class="page-hero">
  <div class="pattern pattern--fade-down"></div>
  <span class="page-hero__disc page-hero__disc--teal" aria-hidden="true"></span>
  <span class="page-hero__disc page-hero__disc--saffron" aria-hidden="true"></span>

  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={pageHref(lang, 'home')}>{t.pages.home.nav}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{meta.nav}</span>
      </nav>
      <h1 class="page-hero__title">{meta.heading}</h1>
      <p class="lead">{meta.lead}</p>
      <slot />
    </div>
    <div class="page-hero__verse">
      <AyahCard lang={lang} page={page} />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(3.5rem, 7vw, 6rem);
    background: linear-gradient(180deg, var(--sand-100), var(--paper));
  }

  .page-hero .pattern {
    z-index: -2;
    --pattern-opacity: 0.14;
  }

  .page-hero__disc {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
  }

  .page-hero__disc--teal {
    right: -7rem;
    top: -9rem;
    width: 26rem;
    height: 26rem;
    background: var(--teal-100);
  }

  .page-hero__disc--saffron {
    right: 34%;
    bottom: -4rem;
    width: 9rem;
    height: 9rem;
    background: var(--saffron-100);
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .crumbs a {
    color: var(--teal-700);
  }

  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .page-hero__title {
    margin-top: 1.1rem;
    font-size: calc(clamp(2.2rem, 3.2vw + 1.1rem, 3.6rem) * var(--display-scale));
    font-weight: 700;
  }

  .page-hero .lead {
    margin-top: 1.2rem;
  }

  @media (max-width: 60rem) {
    .page-hero__grid {
      grid-template-columns: 1fr;
    }

    .page-hero__disc--saffron {
      display: none;
    }

    /* Keep the disc clear of the heading on narrow screens. */
    .page-hero__disc--teal {
      right: -6rem;
      top: -7rem;
      width: 16rem;
      height: 16rem;
    }
  }
</style>

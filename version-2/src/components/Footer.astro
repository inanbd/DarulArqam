---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../config/site';
import { arabic, getDict, type Lang } from '../i18n';
import { num } from '../lib/format';
import { menu, pageHref } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const other = t.alt.lang as Lang;
const { email, whatsappNumber, whatsappDisplay } = site.contact;
const year = num(new Date().getFullYear(), lang);
---

<footer class="footer on-dark">
  <span class="pattern pattern--corner"></span>
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href={pageHref(lang, 'home')}>
        <Logo size={54} />
        <span>
          <span class="footer__name">{t.brand.name}</span>
          <span class="footer__tagline">{t.brand.tagline}</span>
        </span>
      </a>
      <p class="footer__about">{t.footer.about}</p>
      <p class="footer__arabic" lang="ar" dir="rtl">{arabic.name}</p>
    </div>

    <nav class="footer__column" aria-label={t.common.footerPages}>
      <h2 class="footer__heading">{t.common.footerPages}</h2>
      <ul>
        {
          menu.map((id) => (
            <li>
              <a href={pageHref(lang, id)}>{t.pages[id].nav}</a>
            </li>
          ))
        }
        <li><a href={pageHref(lang, 'trial')}>{t.nav.cta}</a></li>
      </ul>
    </nav>

    <nav class="footer__column" aria-label={t.common.footerPrograms}>
      <h2 class="footer__heading">{t.common.footerPrograms}</h2>
      <ul>
        {
          t.programs.items.map((program) => (
            <li>
              <a href={pageHref(lang, 'programs', `#${program.id}`)}>{program.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__column">
      <h2 class="footer__heading">{t.footer.contact}</h2>
      <ul>
        {
          whatsappNumber && (
            <li>
              <a class="footer__contact" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener">
                <Icon name="chat" size={18} />
                {whatsappDisplay}
              </a>
            </li>
          )
        }
        {
          email && (
            <li>
              <a class="footer__contact" href={`mailto:${email}`}>
                <Icon name="mail" size={18} />
                {email}
              </a>
            </li>
          )
        }
        <li>
          <a class="footer__contact" href={pageHref(other, 'home')} lang={other} hreflang={other}>
            <Icon name="globe" size={18} />
            {t.alt.label}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer__base">
    <p>© {year} {t.brand.name}. {t.footer.rights}</p>
    <p>{t.footer.reach}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    background: var(--navy-950);
    color: var(--on-dark-soft);
  }

  .footer .pattern {
    z-index: -1;
    --pattern-color: #6d8ee0;
    --pattern-opacity: 0.2;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr) minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }

  .footer__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.1;
    color: #fff;
  }

  .footer__tagline {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--saffron-400);
  }

  :global(html[lang='bn']) .footer__tagline {
    font-size: 0.86rem;
    letter-spacing: 0;
  }

  .footer__about {
    max-width: 24rem;
    margin-top: 1.4rem;
  }

  .footer__arabic {
    margin-top: 1.1rem;
    font-family: var(--font-kufi);
    font-size: 1.9rem;
    line-height: 1.5;
    color: var(--teal-500);
    text-align: left;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--saffron-400);
  }

  :global(html[lang='bn']) .footer__heading {
    font-size: 0.98rem;
    letter-spacing: 0;
  }

  .footer__column ul {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  .footer__column a {
    color: var(--on-dark);
    overflow-wrap: anywhere;
    transition: color 0.2s var(--ease);
  }

  .footer__column a:hover {
    color: var(--saffron-400);
  }

  .footer__contact {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .footer__contact :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--teal-500);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgba(180, 192, 220, 0.18);
    font-size: 0.9rem;
  }

  @media (max-width: 62rem) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 38rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__column:last-child {
      grid-column: 1 / -1;
    }
  }
</style>

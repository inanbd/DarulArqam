---
import type { Review } from '../config/reviews';
import { academy } from '../content';
import { getDict, type Lang } from '../i18n';

/** One review: stars, the quote, and who wrote it. */
interface Props {
  lang: Lang;
  review: Review;
}

const { lang, review } = Astro.props;
const t = getDict(lang);
const r = t.reviews;
const text = review.text[lang];
const program = academy(lang).programs.find((entry) => entry.id === review.program);
const initial = [...text.name][0];
---

<figure class="review card" data-program={review.program}>
  <div class="review__top">
    <span class="review__stars" role="img" aria-label={r.rating(review.rating)}>
      {[1, 2, 3, 4, 5].map((n) => <span class:list={{ off: n > review.rating }}>★</span>)}
    </span>
    {review.example && <span class="review__example">{r.example}</span>}
  </div>
  <blockquote class="review__quote">
    <p>{text.quote}</p>
  </blockquote>
  <figcaption class="review__by">
    <span class:list={['review__avatar', `review__avatar--${review.role}`]} aria-hidden="true">{initial}</span>
    <span>
      <span class="review__name">{text.name}</span>
      <span class="review__detail">{text.detail}</span>
      <span class="review__meta">
        {text.place}
        {program && <span class="chip review__program">{program.short}</span>}
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .review {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    height: 100%;
    padding: 1.75rem 1.6rem 1.5rem;
  }

  /* A large saffron quotation mark behind the text. */
  .review::before {
    content: '“';
    position: absolute;
    right: 1.25rem;
    top: 0.25rem;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: var(--saffron-100);
    pointer-events: none;
  }

  .review__top {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .review__stars {
    display: inline-flex;
    gap: 0.15rem;
    font-size: 1.15rem;
    line-height: 1;
    color: var(--saffron-500);
  }

  .review__stars .off {
    color: var(--sand-300);
  }

  .review__example {
    padding: 0.15rem 0.65rem;
    border: 1px dashed var(--sand-300);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  :global(html[lang='bn']) .review__example {
    font-size: 0.8rem;
    letter-spacing: 0;
  }

  .review__quote {
    position: relative;
    flex: 1;
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ink);
  }

  .review__by {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--sand-300);
  }

  .review__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    background: var(--teal-100);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--teal-800);
  }

  .review__avatar--student {
    background: var(--saffron-100);
    color: var(--saffron-ink);
  }

  .review__name {
    display: block;
    font-weight: 700;
    line-height: 1.3;
    color: var(--navy-900);
  }

  .review__detail {
    display: block;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .review__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .review__program {
    padding: 0.1rem 0.6rem;
    font-size: 0.78rem;
  }
</style>

---
import Icon from './Icon.astro';
import { academy } from '../content';
import { getDict, type Lang } from '../i18n';
import { pageHref, programPage } from '../lib/routes';
import { programIcons } from '../lib/programs';

/** The three programs and Deeniyat as compact cards that lead to their pages. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { deeniyat, programs } = academy(lang);
const t = getDict(lang);
const cards = [
  ...programs.map((program) => ({ id: program.id, name: program.name, emblem: program.emblem, tagline: program.tagline, format: program.format, ages: program.ages })),
  { id: 'deeniyat', name: deeniyat.name, emblem: deeniyat.emblem, tagline: deeniyat.gloss, format: t.common.deeniyatFormat, ages: t.common.deeniyatAges },
];
---

<ul class="teasers">
  {
    cards.map((card, index) => (
      <li class="teaser card" data-reveal style={`--reveal-order: ${index}`}>
        <div class="teaser__top">
          <span class="icon-tile icon-tile--navy">
            <Icon name={programIcons[card.id]} size={24} />
          </span>
          <span class="teaser__emblem" lang="ar" dir="rtl" aria-hidden="true">
            {card.emblem}
          </span>
        </div>
        <h3 class="teaser__name">{card.name}</h3>
        <p class="teaser__tagline">{card.tagline}</p>
        <p class="teaser__audience">
          <span>{card.format}</span>
          {card.ages}
        </p>
        <a class="link teaser__link" href={pageHref(lang, programPage[card.id])}>
          {t.common.learnMore}
          <span class="sr-only">: {card.name}</span>
          <Icon name="arrow" size={17} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .teasers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .teaser {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1.5rem;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease),
      opacity 0.7s var(--ease);
  }

  .teaser:hover {
    transform: translateY(-4px);
    border-color: var(--teal-200);
    box-shadow: var(--shadow-lift);
  }

  /* Deeniyat is not a program of its own: it comes with the Qur'an programs. */
  .teaser:last-child {
    background: linear-gradient(160deg, var(--saffron-100), #fff);
    border-color: var(--saffron-400);
  }

  .teaser__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .teaser__emblem {
    font-family: var(--font-kufi);
    font-size: 1.7rem;
    line-height: 1.4;
    color: var(--teal-500);
  }

  .teaser__name {
    margin-top: 1.2rem;
    font-size: calc(1.4rem * var(--display-scale));
  }

  .teaser__tagline {
    margin-top: 0.35rem;
    color: var(--ink-soft);
  }

  .teaser__audience {
    display: grid;
    gap: 0.1rem;
    margin-top: 1.1rem;
    margin-bottom: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--sand-300);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .teaser__audience span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--saffron-ink);
  }

  .teaser__link {
    margin-top: auto;
  }

  /* The whole card is the link target. */
  .teaser__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  @media (max-width: 66rem) {
    .teasers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .teasers {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { alimiyah } from '../content/academy';

/** The assessment model of the Youth and Adult divisions, as one bar split by weight. */
const { intro, rows, note } = alimiyah.policies.grading;
const tones = ['#b5dccb', '#0f9a70', '#dfc689', '#08664b', '#063d30'];
---

<figure class="weights">
  <figcaption class="weights__intro">{intro}</figcaption>
  <div class="weights__bar" role="img" aria-label={rows.map((row) => `${row.component} ${row.weight}%`).join(', ')}>
    {rows.map((row, index) => <span style={`flex: ${row.weight}; background: ${tones[index]}`}>{row.weight}%</span>)}
  </div>
  <ul class="weights__legend">
    {
      rows.map((row, index) => (
        <li>
          <span class="weights__dot" style={`background: ${tones[index]}`} />
          {row.component}
          <strong>{row.weight}%</strong>
        </li>
      ))
    }
  </ul>
  <p class="weights__note">{note}</p>
</figure>

<style>
  .weights__intro {
    color: var(--ink-soft);
  }

  .weights__bar {
    display: flex;
    gap: 3px;
    margin-top: 1.1rem;
    overflow: hidden;
    border-radius: 0.9rem;
  }

  .weights__bar span {
    display: grid;
    place-items: center;
    min-height: 3.25rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
  }

  /* Dark figures on the light segments. */
  .weights__bar span:nth-child(1),
  .weights__bar span:nth-child(3) {
    color: var(--navy-950);
  }

  .weights__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.1rem;
    font-size: 0.96rem;
  }

  .weights__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .weights__legend strong {
    color: var(--navy-900);
  }

  .weights__dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
  }

  .weights__note {
    margin-top: 1.1rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>

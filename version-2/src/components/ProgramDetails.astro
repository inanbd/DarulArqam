---
import Icon from './Icon.astro';
import { arabic, getDict, type Lang } from '../i18n';
import { counter } from '../lib/format';
import { pageHref } from '../lib/routes';
import { programIcons } from '../lib/programs';

/** Each program in full, one panel per program. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<nav class="jump" aria-label={t.pages.programs.nav}>
  {
    t.programs.items.map((program) => (
      <a class="chip" href={`#${program.id}`}>
        <Icon name={programIcons[program.id]} size={16} />
        {program.name}
      </a>
    ))
  }
</nav>

<div class="programs">
  {
    t.programs.items.map((program, index) => (
      <article class="program card" id={program.id} data-reveal>
        <div class="program__main">
          <div class="program__top">
            <span class="icon-tile icon-tile--navy">
              <Icon name={programIcons[program.id]} size={26} />
            </span>
            <span class="program__number">{counter(index, lang)}</span>
          </div>
          <h2 class="program__name">{program.name}</h2>
          <p class="program__tagline">{program.tagline}</p>
          <p class="program__text">{program.text}</p>
          <p class="program__audience">
            <span>{t.programs.forLabel}</span>
            {program.audience}
          </p>
          <a class="btn btn--navy" href={pageHref(lang, 'trial')}>
            {t.common.startTrial}
            <Icon name="arrow" size={18} />
          </a>
        </div>

        <div class="program__learn">
          <span class="program__emblem" lang="ar" dir="rtl" aria-hidden="true">
            {arabic.programs[program.id]}
          </span>
          <h3 class="program__learn-title">{t.common.whatYouLearn}</h3>
          <ul class="ticks">
            {program.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .jump .chip {
    padding: 0.55rem 1.05rem;
    font-size: 0.95rem;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .jump .chip:hover {
    background: var(--navy-900);
    color: #fff;
  }

  .programs {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .program {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    overflow: hidden;
    scroll-margin-top: 7rem;
  }

  .program__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 3.5vw, 3rem);
  }

  .program__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .program__number {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--saffron-ink);
  }

  .program__name {
    margin-top: 1.25rem;
    font-size: calc(clamp(1.8rem, 1.6vw + 1.2rem, 2.4rem) * var(--display-scale));
  }

  .program__tagline {
    margin-top: 0.35rem;
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--teal-700);
  }

  .program__text {
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .program__audience {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    margin-top: 1.25rem;
    margin-bottom: 1.75rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .program__audience span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--saffron-ink);
  }

  :global(html[lang='bn']) .program__audience span {
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  .program__main .btn {
    margin-top: auto;
  }

  .program__learn {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    background: var(--teal-50);
    border-left: 1px solid var(--sand-200);
  }

  /* Every other panel swaps sides and tint, so the page has a rhythm. */
  .program:nth-child(even) .program__main {
    order: 2;
  }

  .program:nth-child(even) .program__learn {
    background: var(--sand-100);
    border-left: 0;
    border-right: 1px solid var(--sand-200);
  }

  .program__emblem {
    position: absolute;
    right: 1.25rem;
    top: 0.5rem;
    font-family: var(--font-kufi);
    font-size: 4.75rem;
    line-height: 1.5;
    color: var(--teal-200);
    pointer-events: none;
  }

  .program:nth-child(even) .program__emblem {
    color: var(--sand-300);
  }

  .program__learn-title {
    position: relative;
    margin-top: 4.5rem;
    margin-bottom: 1.1rem;
    font-size: calc(1.3rem * var(--display-scale));
  }

  .program__learn .ticks {
    position: relative;
  }

  .program__learn .ticks li::before {
    background-color: #fff;
  }

  @media (max-width: 54rem) {
    .program {
      grid-template-columns: 1fr;
    }

    .program:nth-child(even) .program__main {
      order: 0;
    }

    .program__learn,
    .program:nth-child(even) .program__learn {
      border-left: 0;
      border-right: 0;
      border-top: 1px solid var(--sand-200);
    }

    .program__learn-title {
      margin-top: 3rem;
    }
  }
</style>

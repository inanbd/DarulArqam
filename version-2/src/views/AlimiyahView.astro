---
import Page from '../layouts/Page.astro';
import Facts from '../components/Facts.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SemesterPath from '../components/SemesterPath.astro';
import Shamsa from '../components/Shamsa.astro';
import Syllabus from '../components/Syllabus.astro';
import Weights from '../components/Weights.astro';
import { alimiyah } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { num } from '../lib/format';
import { pageHref } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.common;
const { junior, youth, adult, policies } = alimiyah;
---

<Page lang={lang} page="alimiyah">
  <PageHero lang={lang} page="alimiyah">
    <Facts facts={[{ icon: 'people', text: c.groupClasses }, { icon: 'child', text: 'Ages 3 to adult' }, { icon: 'layers', text: c.divisions }]} />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="prose" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.overview}</p>
        {alimiyah.overview.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <!-- An age line from 3 to adulthood, with the three divisions along it. -->
      <ol class="ages block">
        {
          alimiyah.divisions.map((division, index) => (
            <li class="age" data-reveal style={`--reveal-order: ${index}`}>
              <span class="age__range">{num(division.ages, lang)}</span>
              <a class="age__card card pad" href={`#${division.id}`}>
                <span class="label">{c.ages} {num(division.ages, lang)}</span>
                <h2 class="h3">{division.name}</h2>
                <p>{division.focus}</p>
                <span class="chip chip--plain">{division.structure}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="note" data-reveal><strong>{c.placement}.</strong> {alimiyah.placement}</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.subjects}</p>
        <h2 class="title">What the curriculum covers</h2>
        <p class="lead">{c.subjectsLead}</p>
      </header>
      <ol class="subjects block">
        {alimiyah.subjects.map((subject, index) => <li data-reveal><span>{num(String(index + 1).padStart(2, '0'), lang)}</span>{subject}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="junior">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.ages} {num(alimiyah.divisions[0].ages, lang)}</p>
        <h2 class="title">{alimiyah.divisions[0].name}</h2>
        <p class="lead">{junior.overview}</p>
      </header>
      <ol class="cols cols--3 block">
        {
          junior.stages.map((stage, index) => (
            <li class="card pad" data-reveal style={`--reveal-order: ${index}`}>
              <div class="junior__head">
                <span class="path__badge">{stage.letter}</span>
                <span class="chip chip--saffron">{c.ages} {num(stage.ages, lang)}</span>
              </div>
              <h3 class="h3" style="margin-top: 1rem">{stage.name}</h3>
              <p style="margin-top: 0.5rem; color: var(--ink-soft)">{stage.focus}.</p>
              <Syllabus label={c.whatIsCovered} units={stage.areas} />
            </li>
          ))
        }
      </ol>
      <div class="cols cols--2 block">
        <aside class="card pad" data-reveal>
          <h3 class="h3">{c.outcomes}</h3>
          <ul class="ticks" style="margin-top: 1rem">
            {junior.outcomes.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
        <aside class="card pad" data-reveal style="--reveal-order: 1">
          <h3 class="h3">{c.assessment}</h3>
          <ul class="chips" style="margin-top: 1rem">
            {junior.assessment.map((item) => <li class="chip chip--plain">{item}</li>)}
          </ul>
          <p style="margin-top: 1rem; color: var(--ink-soft)">{junior.assessmentNote}</p>
          <p style="margin-top: 0.6rem; color: var(--ink-soft)">{junior.completion}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="youth">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.ages} {num(alimiyah.divisions[1].ages, lang)}</p>
        <h2 class="title">{alimiyah.divisions[1].name}</h2>
        <p class="lead">{youth.overview}</p>
      </header>
      <h3 class="h3 block">{c.pathway}</h3>
      <div style="margin-top: 1.25rem">
        <SemesterPath lang={lang} semesters={youth.semesters} />
      </div>
      <p class="note" data-reveal>{youth.placement}</p>
      <div class="cols cols--2 block">
        <aside class="card pad" data-reveal>
          <span class="icon-tile"><Icon name="spark" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.finalProject}</h3>
          <ul class="ticks" style="margin-top: 0.9rem">
            {youth.project.options.map((item) => <li>{item}</li>)}
          </ul>
          <p style="margin-top: 0.9rem; color: var(--ink-soft)">{youth.project.note}</p>
        </aside>
        <aside class="card pad" data-reveal style="--reveal-order: 1">
          <span class="icon-tile icon-tile--saffron"><Icon name="check" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.outcomes}</h3>
          <ul class="ticks" style="margin-top: 0.9rem">
            {youth.objectives.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="adult">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.ages} {num(alimiyah.divisions[2].ages, lang)}</p>
        <h2 class="title">{alimiyah.divisions[2].name}</h2>
        <p class="lead">{adult.overview[0]}</p>
      </header>
      <h3 class="h3 block">{c.pathway}</h3>
      <div style="margin-top: 1.25rem">
        <SemesterPath lang={lang} semesters={adult.semesters} />
      </div>
      <p class="note" data-reveal>{adult.structure}</p>
      <div class="cols cols--2 block">
        <aside class="card pad" data-reveal>
          <span class="icon-tile"><Icon name="spark" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.finalProject}</h3>
          <ul class="ticks" style="margin-top: 0.9rem">
            {adult.project.options.map((item) => <li>{item}</li>)}
          </ul>
          <p style="margin-top: 0.9rem; color: var(--ink-soft)">{adult.project.note}</p>
        </aside>
        <aside class="card pad" data-reveal style="--reveal-order: 1">
          <span class="icon-tile icon-tile--saffron"><Icon name="check" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.outcomes}</h3>
          <ul class="ticks" style="margin-top: 0.9rem">
            {adult.outcomes.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.assessment}</p>
        <h2 class="title">{c.grading}</h2>
      </header>
      <div class="card pad block" data-reveal>
        <Weights />
      </div>
      <div class="cols cols--3 block">
        <aside class="card pad" data-reveal>
          <span class="icon-tile"><Icon name="globe" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.language}</h3>
          <p style="margin-top: 0.6rem; color: var(--ink-soft)">{policies.language}</p>
        </aside>
        <aside class="card pad" data-reveal style="--reveal-order: 1">
          <span class="icon-tile icon-tile--saffron"><Icon name="people" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.differences}</h3>
          <p style="margin-top: 0.6rem; color: var(--ink-soft)">{policies.differences}</p>
        </aside>
        <aside class="card pad" data-reveal style="--reveal-order: 2">
          <span class="icon-tile icon-tile--navy"><Icon name="certificate" size={24} /></span>
          <h3 class="h3" style="margin-top: 1rem">{c.certification}</h3>
          {alimiyah.certification.policy.map((paragraph) => <p style="margin-top: 0.6rem; color: var(--ink-soft)">{paragraph}</p>)}
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="kicker"><Shamsa size={14} />{t.pages.alimiyah.nav}</p>
        <h2 class="title">{c.summary}</h2>
      </header>
      <div class="card table-wrap block" data-reveal>
        <table class="table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">{c.feature}</span></th>
              {alimiyah.divisions.map((division) => <th scope="col">{division.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              alimiyah.summary.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  <td>{num(row.junior, lang)}</td>
                  <td>{num(row.youth, lang)}</td>
                  <td>{num(row.adult, lang)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note" data-reveal>
        {t.tuition.group.text}
        <a class="link" href={pageHref(lang, 'tuition')}>{c.seeTuition}<Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>
</Page>

<style>
  .note {
    margin-top: 1.5rem;
    max-width: 52rem;
    color: var(--ink-soft);
  }

  .note strong {
    color: var(--navy-900);
  }

  .note .link {
    margin-left: 0.5rem;
  }

  /* ----- The age line ----- */

  .ages {
    position: relative;
    display: grid;
    grid-template-columns: 9fr 13fr 10fr;
    gap: 1rem;
    padding-top: 3.25rem;
  }

  /* The line itself, from age 3 on the left to adulthood on the right. */
  .ages::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 1.15rem;
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--teal-500) 0 28%, var(--saffron-500) 28% 69%, var(--lapis) 69% 100%);
  }

  .age {
    position: relative;
  }

  .age__range {
    position: absolute;
    left: 0;
    top: -3.25rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--navy-900);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    box-shadow: 0 0 0 4px var(--paper);
  }

  .age__card {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    height: 100%;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .age__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .age__card p {
    color: var(--ink-soft);
  }

  /* ----- Subjects ----- */

  .subjects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.75rem;
  }

  .subjects li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--teal-200);
    border-radius: var(--radius-sm);
    background: #fff;
    font-weight: 600;
    line-height: 1.35;
    color: var(--navy-900);
  }

  .subjects span {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--teal-600);
  }

  .junior__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (max-width: 56rem) {
    .ages {
      grid-template-columns: 1fr;
      padding-top: 0;
      padding-left: 1.75rem;
      row-gap: 3.5rem;
      margin-top: 3.5rem;
    }

    .ages::before {
      left: 0;
      right: auto;
      top: 0;
      bottom: 0;
      width: 6px;
      height: auto;
      background: linear-gradient(180deg, var(--teal-500) 0 30%, var(--saffron-500) 30% 68%, var(--lapis) 68% 100%);
    }

    .age__range {
      top: -2.6rem;
    }
  }
</style>

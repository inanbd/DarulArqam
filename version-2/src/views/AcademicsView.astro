---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Shamsa from '../components/Shamsa.astro';
import Weights from '../components/Weights.astro';
import { alimiyah, framework } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { num } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.common;
const { policies } = alimiyah;
---

<Page lang={lang} page="academics">
  <PageHero lang={lang} page="academics" />

  <section class="section">
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.philosophy}</p>
        <h2 class="title">Four principles behind every lesson</h2>
        <p class="lead">{framework.philosophy.intro}</p>
      </header>

      <!-- Knowledge leads to understanding, understanding to practice, practice to character. -->
      <ol class="principles block">
        {
          framework.philosophy.principles.map((principle, index) => (
            <li class="principle" data-reveal style={`--reveal-order: ${index}`}>
              <span class="principle__number">{num(index + 1, lang)}</span>
              <h3 class="principle__name">{principle.name}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="center-note" data-reveal>{framework.philosophy.note}</p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container cols cols--2">
      <article class="card pad" data-reveal>
        <span class="icon-tile"><Icon name="book" size={24} /></span>
        <h2 class="h2">{c.teaching}</h2>
        <p class="soft">{framework.teaching.intro}</p>
        <ul class="ticks" style="margin-top: 1rem">
          {framework.teaching.points.map((point) => <li>{point}</li>)}
        </ul>
        <p class="soft">{framework.teaching.note}</p>
        <h3 class="label" style="margin-top: 1.4rem">{c.methods}</h3>
        <ul class="chips" style="margin-top: 0.6rem">
          {policies.methods.map((method) => <li class="chip chip--plain">{method}</li>)}
        </ul>
      </article>

      <article class="card pad" data-reveal style="--reveal-order: 1">
        <span class="icon-tile icon-tile--saffron"><Icon name="check" size={24} /></span>
        <h2 class="h2">{c.assessmentProgress}</h2>
        <p class="soft">{framework.assessment.intro} {framework.assessment.lead}</p>
        <ul class="ticks" style="margin-top: 1rem">
          {framework.assessment.methods.map((method) => <li>{method}</li>)}
        </ul>
        <p class="soft">{framework.assessment.purpose}</p>
        <p class="soft">{framework.assessment.parents}</p>
      </article>
    </div>

    <div class="container block">
      <div class="card pad" data-reveal>
        <h2 class="h2" style="margin-top: 0">{c.grading}</h2>
        <div style="margin-top: 0.75rem">
          <Weights />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cols cols--2">
      <article class="card pad" data-reveal>
        <span class="icon-tile icon-tile--navy"><Icon name="scholar" size={24} /></span>
        <h2 class="h2">{c.faculty}</h2>
        {framework.faculty.intro.map((paragraph) => <p class="soft">{paragraph}</p>)}
        <ul class="ticks" style="margin-top: 1rem">
          {framework.faculty.expectations.map((item) => <li>{item}</li>)}
        </ul>
        <p class="soft">{policies.faculty.note}</p>
      </article>

      <article class="card pad" data-reveal style="--reveal-order: 1">
        <span class="icon-tile"><Icon name="heart" size={24} /></span>
        <h2 class="h2">{c.welfare}</h2>
        <p class="soft">{framework.welfare.intro}</p>
        <ul class="ticks" style="margin-top: 1rem">
          {framework.welfare.points.map((item) => <li>{item}</li>)}
        </ul>
        <p class="soft">{framework.welfare.aim}</p>
      </article>
    </div>

    <div class="container cols cols--3 block">
      <aside class="card pad" data-reveal>
        <h3 class="h3">{c.progression}</h3>
        <p class="soft">{policies.progression}</p>
      </aside>
      <aside class="card pad" data-reveal style="--reveal-order: 1">
        <h3 class="h3">{c.integrity}</h3>
        <p class="soft">{policies.integrity}</p>
      </aside>
      <aside class="card pad" data-reveal style="--reveal-order: 2">
        <h3 class="h3">{c.certification}</h3>
        {alimiyah.certification.policy.map((paragraph) => <p class="soft">{paragraph}</p>)}
      </aside>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container cols cols--2">
      <article data-reveal>
        <p class="kicker"><Shamsa size={14} />{c.community}</p>
        <div class="prose" style="margin-top: 1rem">
          {framework.community.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
      <article data-reveal style="--reveal-order: 1">
        <p class="kicker"><Shamsa size={14} />{c.improvement}</p>
        <div class="prose" style="margin-top: 1rem">
          {framework.improvement.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
    </div>
  </section>
</Page>

<style>
  .h2 {
    margin-top: 1.1rem;
    font-size: calc(1.7rem * var(--display-scale));
  }

  .soft {
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }

  .center-note {
    max-width: 40rem;
    margin: 2rem auto 0;
    font-weight: 600;
    color: var(--teal-800);
    text-align: center;
  }

  /* ----- Four principles, each leading to the next ----- */

  .principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .principle {
    position: relative;
    padding: 1.75rem 1.4rem;
    border-radius: var(--radius);
    background: var(--teal-50);
    border: 1px solid var(--teal-200);
    text-align: center;
  }

  .principle:nth-child(2) {
    background: var(--saffron-100);
    border-color: var(--saffron-400);
  }

  .principle:nth-child(3) {
    background: #e3efe8;
    border-color: #b5dccb;
  }

  .principle:nth-child(4) {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--on-dark-soft);
  }

  /* An arrow from each principle to the next. */
  .principle:not(:last-child)::after {
    content: '→';
    position: absolute;
    top: 50%;
    right: calc(clamp(1.25rem, 2.5vw, 2rem) * -0.5);
    z-index: 1;
    transform: translate(50%, -50%);
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--sand-300);
    color: var(--navy-900);
    font-weight: 700;
  }

  .principle__number {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--saffron-600);
  }

  .principle__name {
    margin: 0.3rem 0 0.5rem;
    font-size: calc(1.6rem * var(--display-scale));
  }

  .principle:nth-child(4) .principle__name {
    color: #fff;
  }

  .principle:nth-child(4) .principle__number {
    color: var(--saffron-400);
  }

  .principle p {
    font-size: 0.98rem;
  }

  @media (max-width: 62rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .principle:nth-child(2)::after {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .principles {
      grid-template-columns: 1fr;
    }

    .principle:not(:last-child)::after {
      content: '↓';
      top: 100%;
      right: 50%;
      transform: translate(50%, -25%);
      display: grid;
    }
  }
</style>

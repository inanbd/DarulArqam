---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import Shamsa from '../components/Shamsa.astro';
import Standards from '../components/Standards.astro';
import TeacherGroups from '../components/TeacherGroups.astro';
import { academy } from '../content';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { framework } = academy(lang);
const t = getDict(lang);
---

<Page lang={lang} page="teachers">
  <PageHero lang={lang} page="teachers" />

  <section class="section">
    <div class="container intro">
      <div data-reveal>
        <p class="kicker"><Shamsa size={14} />{t.teachers.eyebrow}</p>
        {t.teachers.paragraphs.map((paragraph) => <p class="intro__text">{paragraph}</p>)}
        <p class="intro__text">{framework.faculty.intro[1]}</p>
        <p class="intro__text intro__note">{t.audience.note}</p>
      </div>
      <div data-reveal style="--reveal-order: 1">
        <Standards lang={lang} />
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="kicker"><Shamsa size={14} />{t.pages.teachers.nav}</p>
        <h2 class="title">{t.teachers.profiles.title}</h2>
        <p class="lead">{t.teachers.profiles.lead}</p>
      </header>
      <div class="block">
        <TeacherGroups lang={lang} />
      </div>
    </div>
  </section>
</Page>

<style>
  .block {
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .intro__text {
    margin-top: 1.1rem;
    color: var(--ink-soft);
  }

  .intro__text:first-of-type {
    margin-top: 1.25rem;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .intro__note {
    font-weight: 700;
    color: var(--teal-800);
  }

  @media (max-width: 56rem) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getDict, type Lang } from '../i18n';
import { counter } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<section class="section section--parchment how" id="how">
  <div class="container">
    <header class="heading heading--center" data-reveal>
      <p class="eyebrow">{t.how.eyebrow}</p>
      <h2 class="title">{t.how.title}</h2>
    </header>

    <ol class="steps">
      {
        t.how.steps.map((step, index) => (
          <li class="step" data-reveal style={`--reveal-order: ${index}`}>
            <span class="step__badge">{counter(index, lang)}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="timeband on-dark" data-reveal data-clock data-locale={lang === 'bn' ? 'bn-BD' : 'en-US'}>
      <div class="pattern pattern--fade-left"></div>
      <div class="timeband__copy">
        <h3 class="timeband__title">{t.how.time.title}</h3>
        <p class="timeband__text">{t.how.time.text}</p>
        <p class="timeband__zones">{t.how.time.zones}</p>
      </div>
      <div class="timeband__clocks" aria-hidden="true" hidden data-clock-panel>
        <div class="clock">
          <span class="clock__label">{t.how.time.yours}</span>
          <span class="clock__time" data-clock-local>--:--</span>
          <span class="clock__place" data-clock-zone></span>
        </div>
        <span class="timeband__divider"></span>
        <div class="clock">
          <span class="clock__label">{t.how.time.dhaka}</span>
          <span class="clock__time" data-clock-dhaka>--:--</span>
          <span class="clock__place" data-clock-day></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Shows the visitor's own time next to the time in Dhaka, and keeps both current.
  const band = document.querySelector<HTMLElement>('[data-clock]');
  const panel = band?.querySelector<HTMLElement>('[data-clock-panel]');

  if (band && panel) {
    try {
      const locale = band.dataset.locale ?? 'en-US';
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const time = (timeZone: string) => new Intl.DateTimeFormat(locale, { hour: 'numeric', minute: '2-digit', timeZone });
      const day = (timeZone: string) => new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone });
      const local = time(zone);
      const dhaka = time('Asia/Dhaka');
      const localDay = day(zone);
      const dhakaDay = day('Asia/Dhaka');

      const set = (selector: string, text: string) => {
        const element = panel.querySelector(selector);
        if (element) element.textContent = text;
      };

      const tick = () => {
        const now = new Date();
        set('[data-clock-local]', local.format(now));
        set('[data-clock-dhaka]', dhaka.format(now));
        set('[data-clock-zone]', localDay.format(now));
        set('[data-clock-day]', dhakaDay.format(now));
      };

      tick();
      panel.hidden = false;
      window.setInterval(tick, 15_000);
    } catch {
      // Without time-zone support the explanation alone is enough.
    }
  }
</script>

<style>
  .steps {
    position: relative;
    display: grid;
    --steps-gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--steps-gap);
    margin-top: clamp(3rem, 6vw, 4.75rem);
  }

  /* The dotted thread that ties the four steps together. */
  .steps::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    left: 2rem;
    /* Stop at the last badge rather than running on to the edge. */
    right: calc((100% - 3 * var(--steps-gap)) / 4 - 2rem);
    border-top: 1px dashed var(--gold-600);
    opacity: 0.6;
  }

  .step {
    position: relative;
  }

  .step__badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--emerald-800);
    color: var(--gold-300);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    box-shadow: 0 0 0 0.6rem var(--parchment);
    /* An eight-pointed star: two squares, one turned on its corner. */
    clip-path: polygon(
      50% 0%,
      64.6% 14.6%,
      85.4% 14.6%,
      85.4% 35.4%,
      100% 50%,
      85.4% 64.6%,
      85.4% 85.4%,
      64.6% 85.4%,
      50% 100%,
      35.4% 85.4%,
      14.6% 85.4%,
      14.6% 64.6%,
      0% 50%,
      14.6% 35.4%,
      14.6% 14.6%,
      35.4% 14.6%
    );
  }

  .step::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: -0.5rem;
    width: 4.5rem;
    height: 4.5rem;
    background: var(--parchment);
  }

  .step__title {
    margin-top: 1.4rem;
    font-size: calc(1.6rem * var(--display-scale));
    font-weight: 600;
    color: var(--emerald-800);
  }

  .step__text {
    margin-top: 0.6rem;
    color: var(--ink-soft);
  }

  /* ----- Time band ----- */

  .timeband {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding: clamp(2rem, 4.5vw, 3.5rem);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--emerald-800), var(--emerald-950));
    color: var(--on-dark);
    box-shadow: var(--shadow-soft);
  }

  .timeband .pattern {
    z-index: -1;
    --pattern-opacity: 0.12;
  }

  .timeband__title {
    font-size: calc(2.1rem * var(--display-scale));
    color: #ffffff;
  }

  .timeband__text {
    margin-top: 0.9rem;
    max-width: 34rem;
    color: var(--on-dark-soft);
  }

  .timeband__zones {
    margin-top: 1.25rem;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  :global(html[lang='bn']) .timeband__zones {
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }

  .timeband__clocks {
    display: flex;
    align-items: stretch;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .timeband__clocks[hidden] {
    display: none;
  }

  .timeband__divider {
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(214, 182, 109, 0.6), transparent);
  }

  .clock {
    display: grid;
    gap: 0.25rem;
    text-align: center;
    min-width: 8.5rem;
  }

  .clock__label {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  :global(html[lang='bn']) .clock__label {
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }

  .clock__time {
    font-family: var(--font-display);
    font-size: calc(2.6rem * (var(--display-scale) + 0.1));
    font-weight: 500;
    line-height: 1.2;
    color: #ffffff;
    white-space: nowrap;
  }

  .clock__place {
    font-size: 0.9rem;
    color: var(--on-dark-soft);
  }

  @media (max-width: 60rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }

    .steps::before {
      display: none;
    }

    .timeband {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeband__clocks {
      justify-content: center;
      padding-top: 1.75rem;
      border-top: 1px solid rgba(214, 182, 109, 0.2);
    }
  }

  @media (max-width: 34rem) {
    .steps {
      grid-template-columns: 1fr;
    }

    .clock {
      min-width: 0;
      flex: 1;
    }

    /* Labels may wrap here; keep both times on the same line regardless. */
    .clock__label {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      min-height: 2.9em;
      line-height: 1.45;
      letter-spacing: 0.14em;
    }

    .clock__time {
      font-size: calc(2rem * (var(--display-scale) + 0.1));
    }
  }
</style>

---
import { khatam } from '../lib/geometry';

interface Props {
  size?: number;
  /** 'solid' fills the star, 'line' draws its outline, 'double' adds an inner star. */
  variant?: 'solid' | 'line' | 'double';
  class?: string;
}

const { size = 16, variant = 'solid', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
  fill={variant === 'solid' ? 'currentColor' : 'none'}
  stroke={variant === 'solid' ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linejoin="round"
>
  <polygon points={khatam(24, 24, 22)} />
  {variant === 'double' && <polygon points={khatam(24, 24, 10, 22.5)} fill="currentColor" stroke="none" />}
</svg>

---
import Logo from './Logo.astro';
import { getDict, type Lang } from '../i18n';
import { href } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={href(t.path)} aria-label={`${t.brand.name} — ${t.brand.tagline}`}>
      <span class="brand__mark"><Logo size={46} /></span>
      <span class="brand__text">
        <span class="brand__name">{t.brand.name}</span>
        <span class="brand__tagline">{t.brand.tagline}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">{t.nav.menu}</span>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="nav" id="site-nav" aria-label={t.nav.label}>
      <ul class="nav__links">
        {
          t.nav.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="nav__actions">
        <a class="lang-switch" href={href(t.alt.path)} lang={t.alt.lang} hreflang={t.alt.lang} title={t.alt.title}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3c2.6 2.4 4 5.6 4 9s-1.4 6.6-4 9c-2.6-2.4-4-5.6-4-9s1.4-6.6 4-9z"></path>
          </svg>
          {t.alt.label}
        </a>
        <a class="btn btn--gold btn--sm" href="#trial">{t.nav.cta}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const close = () => {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    toggle?.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    header.querySelectorAll('.nav a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--on-dark);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background-color: rgba(5, 33, 26, 0.94);
    border-bottom-color: rgba(216, 187, 126, 0.18);
    box-shadow: 0 18px 40px -28px rgba(0, 0, 0, 0.8);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .site-header.is-open {
    background-color: var(--emerald-950);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5.25rem;
    transition: min-height 0.35s var(--ease);
  }

  .is-scrolled .site-header__inner {
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .brand__mark {
    color: var(--gold-400);
  }

  .brand__text {
    display: grid;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: calc(1.7rem * (var(--display-scale) + 0.12));
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .brand__tagline {
    margin-top: 0.3rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  :global(html[lang='bn']) .brand__tagline {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.5rem);
  }

  .nav__links {
    display: flex;
    gap: clamp(1.1rem, 2.2vw, 2.1rem);
  }

  .nav__links a {
    position: relative;
    padding-block: 0.5rem;
    font-size: 0.96rem;
    letter-spacing: 0.03em;
    color: var(--on-dark);
    opacity: 0.86;
    transition: opacity 0.2s var(--ease);
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: var(--gold-400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav__links a:hover {
    opacity: 1;
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.2rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--gold-300);
    transition: color 0.2s var(--ease);
  }

  .lang-switch:hover {
    color: #fff;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(216, 187, 126, 0.35);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle__bars {
    display: grid;
    gap: 5px;
    width: 1.1rem;
    margin-inline: auto;
  }

  .nav-toggle__bars span {
    height: 1.5px;
    background: var(--gold-300);
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .is-open .nav-toggle__bars span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .is-open .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }

  .is-open .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 62rem) {
    .site-header__inner {
      min-height: 4.5rem;
    }

    .nav-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.25rem var(--gutter) 2rem;
      background: var(--emerald-950);
      border-bottom: 1px solid rgba(216, 187, 126, 0.18);
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }

    .is-open .nav {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__links a {
      display: block;
      padding-block: 0.95rem;
      font-family: var(--font-display);
      font-size: calc(1.5rem * (var(--display-scale) + 0.1));
      border-bottom: 1px solid rgba(216, 187, 126, 0.14);
      opacity: 1;
    }

    .nav__links a::after {
      display: none;
    }

    .nav__actions {
      justify-content: space-between;
    }

    /* Without scripts the menu button cannot open anything, so show the links. */
    :global(.no-js) .nav-toggle {
      display: none;
    }

    :global(.no-js) .site-header {
      position: static;
      background: var(--emerald-950);
    }

    :global(.no-js) .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }

    :global(.no-js) .nav {
      position: static;
      display: flex;
      padding: 0 0 1rem;
      width: 100%;
      background: none;
      border: 0;
    }
  }
</style>

---
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';
import { getDict, type Lang } from '../i18n';
import { pageHref, programPages, sectionHref, type PageId } from '../lib/routes';

interface Props {
  lang: Lang;
  page?: PageId;
}

const { lang, page = 'home' } = Astro.props;
const t = getDict(lang);

// Sections of the home page, and the pages that stand beside it.
const links = [
  { label: t.nav.about, href: sectionHref(lang, page, 'about') },
  { label: t.nav.programs, href: sectionHref(lang, page, 'programs'), under: programPages, current: programPages.includes(page) },
  { label: t.nav.academics, href: pageHref(lang, 'academics'), current: page === 'academics' },
  { label: t.nav.teachers, href: sectionHref(lang, page, 'teachers') },
  { label: t.nav.tuition, href: sectionHref(lang, page, 'tuition') },
  { label: t.nav.faq, href: sectionHref(lang, page, 'faq') },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={pageHref(lang, 'home')} aria-label={`${t.brand.name} — ${t.brand.tagline}`}>
      <span class="brand__mark"><Logo size={50} /></span>
      <span class="brand__text">
        <span class="brand__name"><Wordmark height={19} /></span>
        <span class="brand__tagline">{t.brand.tagline}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">{t.nav.menu}</span>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="nav" id="site-nav" aria-label={t.nav.label}>
      <ul class="nav__links">
        {
          links.map((link) => (
            <li class:list={{ 'has-sub': link.under }}>
              <a href={link.href} aria-current={link.current ? 'true' : undefined}>
                {link.label}
              </a>
              {link.under && (
                <ul class="nav__sub">
                  {link.under.map((id) => (
                    <li>
                      <a href={pageHref(lang, id)} aria-current={id === page ? 'page' : undefined}>
                        {t.pages[id].nav}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="nav__actions">
        <a class="btn btn--gold btn--sm" href={sectionHref(lang, page, 'trial')}>{t.nav.cta}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const close = () => {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    toggle?.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    header.querySelectorAll('.nav a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--on-dark);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background-color: rgba(4, 42, 33, 0.94);
    border-bottom-color: rgba(214, 182, 109, 0.18);
    box-shadow: 0 18px 40px -28px rgba(0, 0, 0, 0.8);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .site-header.is-open {
    background-color: var(--emerald-950);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5.25rem;
    transition: min-height 0.35s var(--ease);
  }

  .is-scrolled .site-header__inner {
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .brand__mark {
    color: var(--on-dark); /* the single-colour logo, as on the logo sheet */
  }

  .brand__text {
    display: grid;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: calc(1.7rem * (var(--display-scale) + 0.12));
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .brand__tagline {
    margin-top: 0.3rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  :global(html[lang='bn']) .brand__tagline {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.5rem);
  }

  .nav__links {
    display: flex;
    gap: clamp(1.1rem, 2.2vw, 2.1rem);
  }

  .nav__links a {
    position: relative;
    padding-block: 0.5rem;
    font-size: 0.96rem;
    letter-spacing: 0.03em;
    color: var(--on-dark);
    opacity: 0.86;
    transition: opacity 0.2s var(--ease);
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: var(--gold-400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav__links a:hover,
  .nav__links a[aria-current] {
    opacity: 1;
  }

  .nav__links > li > a:hover::after,
  .nav__links > li > a[aria-current]::after {
    transform: scaleX(1);
  }

  .nav__links > li {
    position: relative;
  }

  /* The program pages open beneath "Programs". */
  .nav__sub {
    position: absolute;
    top: 100%;
    left: -1rem;
    display: none;
    min-width: 11rem;
    padding: 0.5rem 1rem 0.75rem;
    background: var(--emerald-950);
    border: 1px solid rgba(214, 182, 109, 0.25);
    box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.8);
  }

  .has-sub:hover .nav__sub,
  .has-sub:focus-within .nav__sub {
    display: block;
  }

  .nav__sub a {
    display: block;
    padding-block: 0.45rem;
  }

  .nav__sub a::after {
    display: none;
  }

  .nav__sub a[aria-current='page'] {
    color: var(--gold-300);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(214, 182, 109, 0.35);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle__bars {
    display: grid;
    gap: 5px;
    width: 1.1rem;
    margin-inline: auto;
  }

  .nav-toggle__bars span {
    height: 1.5px;
    background: var(--gold-300);
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .is-open .nav-toggle__bars span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .is-open .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }

  .is-open .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 62rem) {
    .site-header__inner {
      min-height: 4.5rem;
    }

    .nav-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.25rem var(--gutter) 2rem;
      background: var(--emerald-950);
      border-bottom: 1px solid rgba(214, 182, 109, 0.18);
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }

    .is-open .nav {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__links a {
      display: block;
      padding-block: 0.95rem;
      font-family: var(--font-display);
      font-size: calc(1.5rem * (var(--display-scale) + 0.1));
      border-bottom: 1px solid rgba(214, 182, 109, 0.14);
      opacity: 1;
    }

    .nav__links a::after {
      display: none;
    }

    .nav__sub {
      position: static;
      display: block;
      min-width: 0;
      padding: 0 0 0 1.25rem;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .nav__sub a {
      font-size: calc(1.2rem * (var(--display-scale) + 0.1));
      color: var(--on-dark-soft);
    }

    .nav__actions {
      justify-content: space-between;
    }

    /* Without scripts the menu button cannot open anything, so show the links. */
    :global(.no-js) .nav-toggle {
      display: none;
    }

    :global(.no-js) .site-header {
      position: static;
      background: var(--emerald-950);
    }

    :global(.no-js) .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }

    :global(.no-js) .nav {
      position: static;
      display: flex;
      padding: 0 0 1rem;
      width: 100%;
      background: none;
      border: 0;
    }
  }
</style>

---
import { deeniyat, programs } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { counter } from '../lib/format';
import { pageHref, programPage } from '../lib/routes';

/** The three programs, and Deeniyat beside them, each leading to its own page. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const cards = [
  ...programs.map((program) => ({ ...program, text: program.summary })),
  {
    id: 'deeniyat',
    name: deeniyat.name,
    emblem: deeniyat.emblem,
    tagline: deeniyat.gloss,
    text: `${deeniyat.objective[0]} ${deeniyat.objective[1]}`,
    points: deeniyat.subjects.slice(0, 5).map((subject) => `${subject.name}: ${subject.gloss.toLowerCase()}`),
    format: 'With Nazirah and Hifz',
    ages: 'Every Qur’an student',
  },
];
---

<section class="section section--parchment programs" id="programs">
  <div class="container">
    <header class="heading heading--center" data-reveal>
      <p class="eyebrow">{t.programs.eyebrow}</p>
      <h2 class="title">{t.programs.title}</h2>
      <p class="lead">{t.programs.lead}</p>
    </header>

    <ol class="programs__grid">
      {
        cards.map((program, index) => (
          <li class="program" data-reveal style={`--reveal-order: ${index % 2}`}>
            <div class="program__top">
              <span class="program__number">{counter(index, lang)}</span>
              <span class="program__emblem" lang="ar" dir="rtl" aria-hidden="true">
                {program.emblem}
              </span>
            </div>
            <h3 class="program__name">{program.name}</h3>
            <p class="program__tagline">{program.tagline}</p>
            <p class="program__text">{program.text}</p>
            <ul class="program__points">
              {program.points.map((point) => <li>{point}</li>)}
            </ul>
            <p class="program__audience">
              <span>{program.format}</span>
              {program.ages}
            </p>
            <a class="program__link" href={pageHref(lang, programPage[program.id])}>
              {t.common.viewProgram}
              <span class="sr-only">: {program.name}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .programs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2.75rem, 5vw, 4.25rem);
  }

  .program {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3.2vw, 2.75rem);
    background: var(--ivory);
    border: 1px solid var(--sand);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }

  .program::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gold-500), var(--gold-300), var(--gold-500));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }

  .program:hover {
    border-color: var(--gold-400);
    box-shadow: var(--shadow-soft);
  }

  .program:hover::before {
    transform: scaleX(1);
  }

  .program__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .program__number {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--gold-ink);
  }

  .program__emblem {
    font-size: 2.6rem;
    line-height: 1.5;
    color: var(--gold-500);
  }

  .program__name {
    margin-top: 0.6rem;
    font-size: calc(2.1rem * var(--display-scale));
    color: var(--emerald-800);
  }

  .program__tagline {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: calc(1.3rem * (var(--display-scale) + 0.04));
    font-style: italic;
    color: var(--gold-ink);
  }

  .program__text {
    margin-top: 1.1rem;
    color: var(--ink-soft);
  }

  .program__points {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.4rem;
    margin-bottom: 1.75rem;
  }

  .program__points li {
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.5;
  }

  .program__points li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.5em;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--gold-500);
    transform: rotate(45deg);
  }

  .program__audience {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sand);
    font-size: 0.98rem;
    color: var(--emerald-800);
  }

  .program__audience span {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  .program__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    margin-top: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--emerald-700);
    border-bottom: 1px solid var(--gold-500);
  }

  .program__link svg {
    transition: transform 0.3s var(--ease);
  }

  .program:hover .program__link svg {
    transform: translateX(4px);
  }

  /* The whole card leads to the program's page. */
  .program__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (max-width: 52rem) {
    .programs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

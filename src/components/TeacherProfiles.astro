---
import Star from './Star.astro';
import { teachers } from '../config/teachers';
import { programs } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { href, num } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.teachers.profiles;

const programNames = Object.fromEntries(programs.map((program) => [program.id, program.short]));
const groups = [
  { id: 'male', label: p.male, note: '', people: teachers.filter((teacher) => teacher.gender === 'male') },
  { id: 'female', label: p.female, note: p.femaleNote, people: teachers.filter((teacher) => teacher.gender === 'female') },
].filter((group) => group.people.length > 0);
---

{
  groups.length > 0 && (
    <div class="container profiles">
      <header class="heading heading--center" data-reveal>
        <div class="ornament">
          <Star size={18} variant="double" />
        </div>
        <h3 class="profiles__title">{p.title}</h3>
        <p class="lead">{p.lead}</p>
      </header>

      {groups.map((group) => (
        <section class="profiles__group" aria-labelledby={`teachers-${group.id}`}>
          <h4 class="profiles__label" id={`teachers-${group.id}`} data-reveal>
            <span>{group.label}</span>
            {group.note && <small>{group.note}</small>}
          </h4>
          <ul class="profiles__grid">
            {group.people.map((teacher, index) => {
              const text = teacher.text[lang];
              return (
                <li class="teacher" data-reveal style={`--reveal-order: ${index}`}>
                  <div class="teacher__portrait">
                    {teacher.photo ? (
                      <img src={href(teacher.photo)} alt={text.name} width="600" height="750" loading="lazy" decoding="async" />
                    ) : (
                      <>
                        <span class="pattern" />
                        <span class="teacher__emblem" lang="ar" dir="rtl" aria-hidden="true">
                          {teacher.emblem}
                        </span>
                      </>
                    )}
                    <span class="teacher__years">{p.experience(num(teacher.years, lang))}</span>
                  </div>

                  <div class="teacher__body">
                    {teacher.example && <p class="teacher__example">{p.example}</p>}
                    <h5 class="teacher__name">{text.name}</h5>
                    <p class="teacher__title">{text.title}</p>
                    <p class="teacher__bio">{text.bio}</p>
                    <ul class="teacher__qualifications">
                      {text.qualifications.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    <dl class="teacher__facts">
                      <div>
                        <dt>{p.teaches}</dt>
                        <dd>{teacher.programs.map((id) => programNames[id] ?? id).join(p.separator)}</dd>
                      </div>
                      <div>
                        <dt>{p.languages}</dt>
                        <dd>{teacher.languages.map((code) => p.languageNames[code] ?? code).join(p.separator)}</dd>
                      </div>
                    </dl>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  .profiles {
    margin-top: clamp(4.5rem, 9vw, 7.5rem);
  }

  .profiles__title {
    margin-top: 1.25rem;
    font-size: calc(clamp(1.9rem, 2.2vw + 1.1rem, 2.75rem) * var(--display-scale));
  }

  .profiles__group {
    margin-top: clamp(2.75rem, 5vw, 4rem);
  }

  /* Group label, set between two fading gold lines. */
  .profiles__label {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--emerald-800);
  }

  .profiles__label::before,
  .profiles__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-500));
  }

  .profiles__label::after {
    transform: scaleX(-1);
  }

  .profiles__label span {
    order: 1;
  }

  .profiles__label small {
    order: 2;
    padding-left: 1.25rem;
    border-left: 1px solid var(--gold-500);
    font-size: inherit;
    font-weight: 400;
    color: var(--gold-ink);
  }

  .profiles__label::after {
    order: 3;
  }

  :global(html[lang='bn']) .profiles__label {
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .profiles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .teacher {
    display: flex;
    flex-direction: column;
    padding: 1rem 1rem 0;
    background: #ffffff;
    border: 1px solid var(--sand);
    border-radius: var(--radius);
    transition:
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }

  .teacher:hover {
    border-color: var(--gold-400);
    box-shadow: var(--shadow-soft);
  }

  /* ----- Portrait: a niche holding a photo, or the teacher's Arabic title ----- */

  .teacher__portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4.1;
    border: 1px solid var(--gold-500);
    border-radius: 12rem 12rem 0.6rem 0.6rem;
    background:
      radial-gradient(70% 60% at 50% 30%, rgba(236, 220, 176, 0.2), transparent 70%),
      linear-gradient(180deg, var(--emerald-600), var(--emerald-900));
    isolation: isolate;
  }

  .teacher__portrait::after {
    content: '';
    position: absolute;
    inset: 0.45rem;
    border: 1px solid rgba(214, 182, 109, 0.35);
    border-radius: 11.6rem 11.6rem 0.3rem 0.3rem;
    pointer-events: none;
  }

  .teacher__portrait .pattern {
    z-index: -1;
    border-radius: inherit;
    --pattern-opacity: 0.16;
  }

  .teacher__portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    border-radius: inherit;
  }

  .teacher__emblem {
    padding-top: 1.5rem;
    font-size: clamp(2.4rem, 2vw + 1.6rem, 3.1rem);
    line-height: 1.6;
    color: var(--gold-300);
    text-shadow: 0 6px 24px rgba(4, 42, 33, 0.5);
  }

  .teacher__years {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 1;
    transform: translate(-50%, 50%);
    padding: 0.35rem 1rem;
    border: 1px solid var(--gold-500);
    border-radius: 999px;
    background: var(--ivory);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--emerald-800);
    white-space: nowrap;
  }

  :global(html[lang='bn']) .teacher__years {
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  /* ----- Details ----- */

  .teacher__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 2rem 0.75rem 0;
    text-align: center;
  }

  .teacher__example {
    align-self: center;
    margin-bottom: 0.85rem;
    padding: 0.15rem 0.7rem;
    border: 1px dashed var(--sand-deep);
    border-radius: 999px;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  :global(html[lang='bn']) .teacher__example {
    font-size: 0.82rem;
    letter-spacing: 0;
  }

  .teacher__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(1.7rem * (var(--display-scale) + 0.02));
    font-weight: 600;
    line-height: calc(var(--display-leading) + 0.08);
    color: var(--emerald-800);
    text-wrap: balance;
  }

  .teacher__title {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: calc(1.22rem * (var(--display-scale) + 0.04));
    font-style: italic;
    line-height: 1.35;
    color: var(--gold-ink);
  }

  :global(html[lang='bn']) .teacher__title {
    font-style: normal;
    line-height: 1.6;
  }

  .teacher__bio {
    margin-top: 1rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }

  .teacher__qualifications {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .teacher__qualifications li {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--parchment);
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--emerald-800);
  }

  .teacher__facts {
    display: grid;
    gap: 0.6rem;
    margin: auto -0.75rem 0;
    padding: 1.1rem 0.75rem 1.25rem;
    border-top: 1px solid var(--sand);
    text-align: left;
  }

  .teacher__facts div {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
  }

  .teacher__facts dt {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  :global(html[lang='bn']) .teacher__facts dt {
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  :global(html[lang='bn']) .teacher__facts div {
    grid-template-columns: 3.5rem minmax(0, 1fr);
  }

  .teacher__facts dd {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
  }

  @media (max-width: 60rem) {
    .profiles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .profiles__grid {
      grid-template-columns: 1fr;
      max-width: 24rem;
      margin-inline: auto;
    }

    .profiles__label small {
      display: none;
    }
  }
</style>

---
import Rosette from './Rosette.astro';
import Star from './Star.astro';
import { arabic, getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);

// A pointed arch, drawn once and reused for the fill and both gold outlines.
const arch = 'M6 594V250C6 132 96 70 220 8c124 62 214 124 214 242v344z';
const archInner = 'M22 594V252c0-106 82-164 198-224 116 60 198 118 198 224v342';
---

<section class="hero on-dark">
  <div class="pattern pattern--fade-left"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__bismillah" lang="ar" dir="rtl">{arabic.bismillah}</p>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero__title">
        {t.hero.title.before}<em>{t.hero.title.accent}</em>{t.hero.title.after}
      </h1>
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--gold" href="#trial">
          {t.hero.primary}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a class="btn btn--ghost" href="#programs">{t.hero.secondary}</a>
      </div>
      <ul class="hero__points">
        {
          t.hero.points.map((point) => (
            <li>
              <Star size={11} />
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__art">
      <Rosette class="hero__rosette" />
      <figure class="arch">
        <svg class="arch__shape" viewBox="0 0 440 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="arch-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0a8a64"></stop>
              <stop offset="0.55" stop-color="#087055"></stop>
              <stop offset="1" stop-color="#06523f"></stop>
            </linearGradient>
            <radialGradient id="arch-light" cx="0.5" cy="0.28" r="0.6">
              <stop offset="0" stop-color="#ecdcb0" stop-opacity="0.22"></stop>
              <stop offset="1" stop-color="#ecdcb0" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <path d={arch} fill="url(#arch-fill)"></path>
          <path d={arch} fill="url(#arch-light)"></path>
          <path d={arch} fill="none" stroke="#d6b66d" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
          <path d={archInner} fill="none" stroke="#d6b66d" stroke-opacity="0.45" stroke-width="1" vector-effect="non-scaling-stroke"></path>
        </svg>
        <blockquote class="arch__body">
          <span class="arch__star"><Star size={26} variant="double" /></span>
          <p class="arch__arabic" lang="ar" dir="rtl">{arabic.hadith}</p>
          <span class="arch__rule" aria-hidden="true"></span>
          <p class="arch__text">{t.hero.hadith.text}</p>
          <footer class="arch__source">
            <cite>{t.hero.hadith.source}</cite>
            <span>{t.hero.hadith.reference}</span>
          </footer>
        </blockquote>
      </figure>
    </div>
  </div>

  <div class="container">
    <ul class="pillars">
      {
        t.pillars.map((pillar) => (
          <li class="pillar">
            <Star size={18} variant="line" class="pillar__icon" />
            <div>
              <h2 class="pillar__title">{pillar.title}</h2>
              <p class="pillar__text">{pillar.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(7.5rem, 13vw, 10.5rem);
    background:
      radial-gradient(120% 90% at 85% 10%, #087c59 0%, transparent 60%),
      linear-gradient(180deg, var(--emerald-900) 0%, var(--emerald-950) 100%);
    color: var(--on-dark);
  }

  .hero .pattern {
    z-index: -1;
    --pattern-opacity: 0.11;
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    right: -10%;
    top: 5%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(214, 182, 109, 0.16) 0%, transparent 62%);
    pointer-events: none;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .hero__bismillah {
    margin-bottom: 1.4rem;
    font-size: 1.55rem;
    color: var(--gold-400);
    text-align: left;
    line-height: 1.6;
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: calc(clamp(2.7rem, 4.6vw + 1.1rem, 4.75rem) * var(--display-scale));
    line-height: calc(var(--display-leading) - 0.04);
    letter-spacing: -0.012em;
    color: #ffffff;
  }

  .hero__title em {
    font-style: italic;
    color: var(--gold-400);
    white-space: nowrap;
  }

  :global(html[lang='bn']) .hero__title em {
    font-style: normal;
  }

  .hero__lead {
    margin-top: 1.6rem;
    max-width: 35rem;
    font-size: 1.17rem;
    color: var(--on-dark-soft);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.3rem;
  }

  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin-top: 2.2rem;
    font-size: 0.95rem;
    color: var(--on-dark);
  }

  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero__points :global(svg) {
    color: var(--gold-500);
    flex-shrink: 0;
  }

  /* ----- Arch ----- */

  .hero__art {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero__art :global(.hero__rosette) {
    position: absolute;
    width: 150%;
    max-width: none;
    color: var(--gold-400);
    opacity: 0.22;
    animation: turn 240s linear infinite;
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  .arch {
    position: relative;
    width: min(100%, 25.5rem);
    aspect-ratio: 440 / 600;
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.45));
  }

  .arch__shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .arch__body {
    position: absolute;
    inset: 27% 11% 8%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    margin: 0;
    text-align: center;
  }

  .arch__star {
    color: var(--gold-400);
  }

  .arch__arabic {
    font-size: clamp(1.7rem, 2.3vw + 0.9rem, 2.45rem);
    line-height: 1.75;
    color: var(--gold-300);
    text-wrap: balance;
  }

  .arch__rule {
    width: 3.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-400), transparent);
  }

  .arch__text {
    font-family: var(--font-display);
    font-size: calc(1.42rem * var(--display-scale));
    font-style: italic;
    line-height: calc(var(--display-leading) + 0.22);
    color: #ffffff;
    text-wrap: balance;
  }

  :global(html[lang='bn']) .arch__text {
    font-style: normal;
    font-weight: 500;
  }

  .arch__source {
    display: grid;
    gap: 0.15rem;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  .arch__source cite {
    font-style: normal;
  }

  .arch__source span {
    color: var(--on-dark-soft);
  }

  :global(html[lang='bn']) .arch__source {
    font-size: 0.88rem;
    letter-spacing: 0.01em;
  }

  /* ----- Pillars ----- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(214, 182, 109, 0.22);
  }

  .pillar {
    display: flex;
    gap: 0.9rem;
    padding: 1.9rem 1.5rem 2.2rem;
    border-left: 1px solid rgba(214, 182, 109, 0.14);
  }

  .pillar:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .pillar:last-child {
    padding-right: 0;
  }

  .pillar :global(.pillar__icon) {
    flex-shrink: 0;
    margin-top: 0.3rem;
    color: var(--gold-400);
  }

  .pillar__title {
    font-size: calc(1.3rem * (var(--display-scale) + 0.06));
    font-weight: 600;
    line-height: 1.25;
    color: #ffffff;
  }

  .pillar__text {
    margin-top: 0.4rem;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--on-dark-soft);
  }

  :global(html[lang='bn']) .pillar__text {
    line-height: 1.7;
  }

  @media (max-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__art {
      order: 2;
    }

    .hero__art :global(.hero__rosette) {
      width: min(130%, 40rem);
    }

    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar,
    .pillar:first-child,
    .pillar:last-child {
      padding: 1.5rem 1.25rem 1.6rem 0;
      border-left: 0;
      border-bottom: 1px solid rgba(214, 182, 109, 0.14);
    }

    .pillar:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 36rem) {
    .hero__bismillah {
      font-size: 1.35rem;
    }

    .hero__cta .btn {
      flex: 1 1 100%;
    }

    .hero__points {
      flex-direction: column;
    }

    .pillars {
      grid-template-columns: 1fr;
    }

    .pillar:nth-last-child(2) {
      border-bottom: 1px solid rgba(214, 182, 109, 0.14);
    }
  }
</style>

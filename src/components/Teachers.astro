---
import Star from './Star.astro';
import TeacherProfiles from './TeacherProfiles.astro';
import { framework } from '../content/academy';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<section class="section teachers" id="teachers">
  <div class="container teachers__grid">
    <div class="teachers__copy" data-reveal>
      <p class="eyebrow">{t.teachers.eyebrow}</p>
      <h2 class="title">{t.teachers.title}</h2>
      {t.teachers.paragraphs.map((paragraph) => <p class="teachers__text">{paragraph}</p>)}
      <p class="teachers__text">{framework.faculty.intro[1]}</p>
      <a class="btn btn--emerald teachers__cta" href="#trial">{t.teachers.cta}</a>
    </div>

    <aside class="standards" data-reveal style="--reveal-order: 1">
      <span class="standards__corner standards__corner--tl" aria-hidden="true"></span>
      <span class="standards__corner standards__corner--tr" aria-hidden="true"></span>
      <span class="standards__corner standards__corner--bl" aria-hidden="true"></span>
      <span class="standards__corner standards__corner--br" aria-hidden="true"></span>
      <h3 class="standards__title">{t.teachers.standardsTitle}</h3>
      <ul class="standards__list">
        {
          framework.faculty.expectations.map((standard) => (
            <li>
              <Star size={15} class="standards__star" />
              {standard}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>

  <TeacherProfiles lang={lang} />
</section>

<style>
  .teachers__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .teachers__text {
    margin-top: 1.4rem;
    color: var(--ink-soft);
  }

  .teachers__text:first-of-type {
    margin-top: 1.75rem;
    font-size: 1.12rem;
    color: var(--ink);
  }

  .teachers__cta {
    margin-top: 2.25rem;
  }

  .standards {
    position: relative;
    padding: clamp(2rem, 4vw, 3.25rem);
    background: var(--parchment);
    border: 1px solid var(--sand-deep);
  }

  /* Gold brackets at each corner, like the frame of a manuscript page. */
  .standards__corner {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    border: 2px solid var(--gold-500);
  }

  .standards__corner--tl {
    top: -6px;
    left: -6px;
    border-right: 0;
    border-bottom: 0;
  }

  .standards__corner--tr {
    top: -6px;
    right: -6px;
    border-left: 0;
    border-bottom: 0;
  }

  .standards__corner--bl {
    bottom: -6px;
    left: -6px;
    border-right: 0;
    border-top: 0;
  }

  .standards__corner--br {
    bottom: -6px;
    right: -6px;
    border-left: 0;
    border-top: 0;
  }

  .standards__title {
    font-size: calc(1.85rem * var(--display-scale));
    color: var(--emerald-800);
  }

  .standards__list {
    margin-top: 1.25rem;
  }

  .standards__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding-block: 1rem;
    border-top: 1px solid var(--sand-deep);
    line-height: 1.5;
  }

  .standards__list li:last-child {
    padding-bottom: 0;
  }

  :global(html[lang='bn']) .standards__list li {
    line-height: 1.7;
  }

  .standards__list :global(.standards__star) {
    flex-shrink: 0;
    margin-top: 0.3rem;
    color: var(--gold-500);
  }

  @media (max-width: 56rem) {
    .teachers__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

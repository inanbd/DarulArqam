---
import Rosette from './Rosette.astro';
import Star from './Star.astro';
import { framework } from '../content/academy';
import { arabic, getDict, type Lang } from '../i18n';
import { counter } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<section class="section about" id="about">
  <div class="container about__grid">
    <figure class="medallion" data-reveal>
      <Rosette class="medallion__rosette" />
      <div class="medallion__core">
        <p class="medallion__name" lang="ar" dir="rtl">{arabic.name}</p>
      </div>
      <figcaption class="medallion__caption">{t.about.medallionCaption}</figcaption>
    </figure>

    <div class="about__copy" data-reveal style="--reveal-order: 1">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="title">{t.about.title}</h2>
      {t.about.paragraphs.map((paragraph) => <p class="about__text">{paragraph}</p>)}
    </div>
  </div>

  <div class="container purpose">
    <article class="purpose__vision" data-reveal>
      <p class="eyebrow">{t.common.vision}</p>
      <p class="purpose__statement">{framework.vision}</p>
    </article>
    <article class="panel panel--framed" data-reveal style="--reveal-order: 1">
      <h3 class="panel__title">{t.common.mission}</h3>
      <ul class="diamonds">
        {framework.mission.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </div>

  <div class="container">
    <h3 class="values__heading" data-reveal>{t.common.values}</h3>
    <ul class="values">
      {
        framework.values.map((value, index) => (
          <li class="value" data-reveal style={`--reveal-order: ${index}`}>
            <span class="value__number">{counter(index, lang)}</span>
            <h4 class="value__name">{value.name}</h4>
            <p class="value__text">{value.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .about__text {
    margin-top: 1.4rem;
    color: var(--ink-soft);
  }

  .about__text:first-of-type {
    margin-top: 1.75rem;
    font-size: 1.12rem;
    color: var(--ink);
  }

  /* ----- Medallion ----- */

  .medallion {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 26rem);
    margin-inline: auto;
  }

  .medallion :global(.medallion__rosette) {
    width: 100%;
    color: var(--gold-600);
  }

  .medallion__core {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .medallion__name {
    display: grid;
    place-items: center;
    width: 31%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--emerald-800);
    color: var(--gold-300);
    font-size: clamp(1.3rem, 2.4vw + 0.6rem, 2rem);
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    box-shadow:
      0 0 0 6px var(--ivory),
      0 0 0 7px var(--gold-500),
      0 24px 40px -20px rgba(4, 42, 33, 0.6);
  }

  .medallion__caption {
    margin-top: 1.4rem;
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-ink);
    text-align: center;
  }

  :global(html[lang='bn']) .medallion__caption {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  /* ----- Vision and mission ----- */

  .purpose {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--sand);
  }

  .purpose__statement {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: calc(clamp(1.7rem, 1.6vw + 1.2rem, 2.4rem) * var(--display-scale));
    font-style: italic;
    line-height: 1.3;
    color: var(--emerald-800);
  }

  /* ----- Values ----- */

  .values__heading {
    margin-top: clamp(3rem, 6vw, 5rem);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-ink);
    text-align: center;
  }

  .values {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 1.75rem;
    border-top: 1px solid var(--gold-500);
  }

  .value {
    padding: 1.75rem 1.25rem 0;
    border-left: 1px solid var(--sand);
  }

  .value:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .value__number {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-ink);
  }

  .value__name {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: calc(1.5rem * var(--display-scale));
    font-weight: 600;
    line-height: 1.2;
    color: var(--emerald-800);
  }

  .value__text {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }

  @media (max-width: 68rem) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .value,
    .value:first-child {
      padding: 1.5rem 1.25rem 1.5rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--sand);
    }
  }

  @media (max-width: 56rem) {
    .about__grid,
    .purpose {
      grid-template-columns: 1fr;
    }

    .medallion {
      width: min(78%, 21rem);
    }

  }
</style>

---
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import SubHero from './SubHero.astro';
import { arabic, getDict, type Lang } from '../i18n';
import { sectionHref, type PageId } from '../lib/routes';

/** The frame of a program or academics page: header, heading, the page itself, a closing call, footer. */
interface Props {
  lang: Lang;
  page: Exclude<PageId, 'home'>;
}

const { lang, page } = Astro.props;
const t = getDict(lang);
---

<Base lang={lang} page={page}>
  <Header lang={lang} page={page} />
  <main id="main">
    <SubHero lang={lang} page={page}>
      <slot name="facts" />
    </SubHero>
    <slot />
    <section class="closing on-dark">
      <div class="pattern pattern--fade-center"></div>
      <div class="container closing__inner" data-reveal>
        <p class="closing__arabic" lang="ar" dir="rtl">{arabic.dua}</p>
        <h2 class="closing__title">{t.common.cta.title}</h2>
        <p class="closing__text">{t.common.cta.text}</p>
        <a class="btn btn--gold" href={sectionHref(lang, page, 'trial')}>{t.common.cta.button}</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} page={page} />
</Base>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: linear-gradient(180deg, var(--emerald-800), var(--emerald-950));
    color: var(--on-dark);
    text-align: center;
  }

  .closing .pattern {
    z-index: -1;
    --pattern-opacity: 0.13;
  }

  .closing__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .closing__arabic {
    font-size: 2.2rem;
    color: var(--gold-300);
  }

  .closing__title {
    font-size: calc(clamp(2.1rem, 2.9vw + 1.1rem, 3.2rem) * var(--display-scale));
    color: #ffffff;
  }

  .closing__text {
    color: var(--on-dark-soft);
  }

  .closing .btn {
    margin-top: 1rem;
  }
</style>

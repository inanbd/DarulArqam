---
import { site } from '../config/site';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const whatsapp = site.contact.whatsappNumber ? `https://wa.me/${site.contact.whatsappNumber}` : '';
---

<section class="section section--parchment faq" id="faq">
  <div class="container faq__grid">
    <header class="heading faq__heading" data-reveal>
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2 class="title">{t.faq.title}</h2>
      <p class="lead">{t.faq.lead}</p>
      {
        whatsapp && (
          <a class="btn btn--outline faq__contact" href={whatsapp} target="_blank" rel="noopener">
            {t.faq.contact}
          </a>
        )
      }
    </header>

    <div class="faq__list" data-reveal style="--reveal-order: 1">
      {
        t.faq.items.map((item, index) => (
          <details class="faq__item" open={index === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5.5rem);
  }

  .faq__heading {
    position: sticky;
    top: 7rem;
  }

  .faq__contact {
    margin-top: 2rem;
  }

  .faq__list {
    border-top: 1px solid var(--sand-deep);
  }

  .faq__item {
    border-bottom: 1px solid var(--sand-deep);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    font-family: var(--font-display);
    font-size: calc(1.5rem * (var(--display-scale) + 0.02));
    font-weight: 600;
    line-height: calc(var(--display-leading) + 0.18);
    color: var(--emerald-800);
    cursor: pointer;
    list-style: none;
    transition: color 0.2s var(--ease);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--emerald-600);
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--gold-500);
    border-radius: 50%;
    transition:
      background-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.75rem;
    height: 1.5px;
    background: var(--gold-ink);
    transform: translate(-50%, -50%);
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    background: var(--emerald-800);
    border-color: var(--emerald-800);
  }

  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: var(--gold-300);
  }

  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__item p {
    max-width: 40rem;
    padding-bottom: 1.6rem;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__heading {
      position: static;
    }
  }
</style>

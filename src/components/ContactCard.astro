---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { getDict, type Lang } from '../i18n';

/** Direct ways to reach the academy. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const { email, whatsappNumber, whatsappDisplay } = site.contact;
---

{
  (whatsappNumber || email) && (
    <aside class="contact card">
      <h2 class="contact__title">{t.trial.contactTitle}</h2>
      <ul>
        {whatsappNumber && (
          <li>
            <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener">
              <span class="icon-tile">
                <Icon name="chat" size={22} />
              </span>
              <span>
                <span class="contact__label">{t.trial.whatsapp}</span>
                <span class="contact__value">{whatsappDisplay}</span>
              </span>
            </a>
          </li>
        )}
        {email && (
          <li>
            <a href={`mailto:${email}`}>
              <span class="icon-tile icon-tile--saffron">
                <Icon name="mail" size={22} />
              </span>
              <span>
                <span class="contact__label">{t.trial.email}</span>
                <span class="contact__value">{email}</span>
              </span>
            </a>
          </li>
        )}
      </ul>
    </aside>
  )
}

<style>
  .contact {
    padding: 1.75rem;
  }

  .contact__title {
    font-size: calc(1.4rem * var(--display-scale));
  }

  .contact ul {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  .contact a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-inline: -0.6rem;
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s var(--ease);
  }

  .contact a:hover {
    background: var(--sand-100);
  }

  .contact__label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  :global(html[lang='bn']) .contact__label {
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  .contact__value {
    display: block;
    font-weight: 700;
    color: var(--navy-900);
    overflow-wrap: anywhere;
  }
</style>

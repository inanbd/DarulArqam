---
import Star from './Star.astro';
import { arabic, getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<section class="ayah on-dark">
  <div class="pattern pattern--fade-center"></div>
  <blockquote class="container ayah__inner" data-reveal>
    <div class="ornament"><Star size={18} variant="double" /></div>
    <p class="ayah__arabic" lang="ar" dir="rtl">{arabic.ayah}</p>
    <p class="ayah__text">{t.ayah.text}</p>
    <footer class="ayah__reference"><cite>{t.ayah.reference}</cite></footer>
  </blockquote>
</section>

<style>
  .ayah {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: linear-gradient(180deg, var(--emerald-800), var(--emerald-900));
    color: var(--on-dark);
    text-align: center;
  }

  .ayah .pattern {
    z-index: -1;
    --pattern-opacity: 0.14;
  }

  .ayah__inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    margin-block: 0;
  }

  .ayah__arabic {
    font-size: clamp(1.9rem, 3.4vw + 0.9rem, 3.4rem);
    line-height: 1.8;
    color: var(--gold-300);
    text-wrap: balance;
  }

  .ayah__text {
    max-width: 40rem;
    font-family: var(--font-display);
    font-size: calc(clamp(1.35rem, 1.1vw + 1.05rem, 1.75rem) * var(--display-scale));
    font-style: italic;
    line-height: calc(var(--display-leading) + 0.25);
    color: #ffffff;
    text-wrap: balance;
  }

  :global(html[lang='bn']) .ayah__text {
    font-style: normal;
  }

  .ayah__reference {
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  .ayah__reference cite {
    font-style: normal;
  }

  :global(html[lang='bn']) .ayah__reference {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
</style>

---
import { type Region } from '../config/fees';
import { northAmericanZones, timetable, week, windowOn } from '../config/timetable';
import { getDict, type Lang } from '../i18n';
import { clockTime, dayRange } from '../lib/clock';
import { num } from '../lib/format';

/**
 * The class timetable of one region: the plans across a week, the class hours
 * in the reader's own time (worked out in the browser), the hours across North
 * America or in Bangladesh, and notes.
 */
interface Props {
  lang: Lang;
  region: Region;
}

const { lang, region } = Astro.props;
const t = getDict(lang);
const tt = t.timetable;
const rule = timetable[region];

// Reference times, worked out from the UTC rule: a Monday in January (standard time) and one in July (daylight time).
const [winterStart, winterEnd] = windowOn(region, 2026, 0, 12);
const [summerStart, summerEnd] = windowOn(region, 2026, 6, 13);
const span = (start: Date, end: Date, zone: string) => `${clockTime(start, zone, lang)} ${tt.to} ${clockTime(end, zone, lang)}`;
const zoneRows = northAmericanZones.map((zone) => ({
  ...zone,
  name: tt.zones[zone.id],
  winter: span(winterStart, winterEnd, zone.iana),
  summer: span(summerStart, summerEnd, zone.iana),
}));
const homeHours = span(winterStart, winterEnd, rule.homeZone);

// Everything the in-your-time script needs.
const settings = {
  locale: lang === 'bn' ? 'bn-BD' : 'en-US',
  startUtc: rule.startUtc,
  hours: rule.hours,
  plans: rule.plans.map((plan) => ({ days: plan.days, on: plan.on, choose: plan.choose ?? 0 })),
  labels: {
    plan: rule.plans.map((plan) => tt.plan(num(plan.days, lang))),
    choose: rule.plans.map((plan) => (plan.choose ? tt.choose(num(plan.choose, lang)) : '')),
    nextDay: tt.nextDay,
    days: tt.days,
    zone: tt.yourZone('{zone}'),
    to: tt.to,
  },
};
---

<div class="timetable" data-for-region={region}>
  <div class="timetable__grid">
    <!-- The plans across a week -->
    <div class="card plans" data-reveal>
      <h3 class="plans__title">{t.region[region]}</h3>
      <p class="plans__hours">
        {region === 'bd' ? tt.bdDays(homeHours) : tt.usHours(homeHours, span(summerStart, summerEnd, rule.homeZone))}
      </p>
      <table class="plans__table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">{tt.plan('')}</span></th>
            {week.map((day) => <th scope="col" title={tt.daysLong[day]}>{tt.days[day]}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rule.plans.map((plan) => (
              <tr>
                <th scope="row">
                  {tt.plan(num(plan.days, lang))}
                  {plan.choose ? <small>{tt.chooseShort(num(plan.choose, lang))}</small> : null}
                </th>
                {week.map((day) => {
                  const on = plan.on.includes(day);
                  return (
                    <td>
                      <span class:list={['slot', { 'is-on': on && !plan.choose, 'is-choice': on && plan.choose }]}>
                        <span class="sr-only">{on ? tt.daysLong[day] : ''}</span>
                      </span>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- In the reader's own time -->
    <div class="card yours" hidden data-yours data-settings={JSON.stringify(settings)}>
      <p class="kicker yours__kicker">{tt.yourTime}</p>
      <ul class="yours__list" data-yours-list></ul>
      <p class="yours__zone" data-yours-zone></p>
    </div>
  </div>

  {
    region === 'us' ? (
      <div class="card zones" data-reveal>
        <h3 class="zones__title">{tt.zoneTable}</h3>
        <div class="zones__wrap">
          <table class="zones__table">
            <thead>
              <tr>
                <th scope="col">{tt.zone}</th>
                <th scope="col">{tt.standard}</th>
                <th scope="col">{tt.daylight}</th>
              </tr>
            </thead>
            <tbody>
              {zoneRows.map((row) => (
                <tr data-iana={row.iana}>
                  <th scope="row">{row.name}</th>
                  <td>{row.winter}</td>
                  <td>{row.summer}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : null
  }

  <ul class="notes">
    {tt.notes[region].map((note) => <li>{note}</li>)}
  </ul>
</div>

<script>
  // Shows each plan's class days and hours in the reader's own time zone, for the coming week.
  document.querySelectorAll<HTMLElement>('[data-yours]').forEach((panel) => {
    try {
      const s = JSON.parse(panel.dataset.settings ?? '{}');
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const utcDays = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      const bn = s.locale === 'bn-BD';
      const clock = new Intl.DateTimeFormat(s.locale, bn ? { hour: 'numeric', minute: '2-digit', dayPeriod: 'short', timeZone: zone } : { hour: 'numeric', minute: '2-digit', timeZone: zone });
      /** "6:30 PM", or in Bangla "সন্ধ্যা ৬:৩০", with the part of the day first. */
      const time = (date: Date) => {
        if (!bn) return clock.format(date);
        const parts = clock.formatToParts(date);
        const part = (type: string) => parts.find((entry) => entry.type === type)?.value ?? '';
        return `${part('dayPeriod') === 'রাত্রি' ? 'রাত' : part('dayPeriod')} ${part('hour')}:${part('minute')}`;
      };
      const dayKey = new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: zone });
      const dateKey = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: zone });

      /** The next window that starts on a given UTC weekday. */
      const next = (day: string) => {
        const now = new Date();
        for (let ahead = 0; ahead < 8; ahead++) {
          const date = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + ahead, s.startUtc[0], s.startUtc[1]));
          if (utcDays[date.getUTCDay()] === day && date.getTime() + s.hours * 3600_000 > now.getTime()) return date;
        }
        return new Date();
      };

      const list = panel.querySelector('[data-yours-list]')!;
      s.plans.forEach((plan: { on: string[]; choose: number }, index: number) => {
        // In the plan's own order: a weekend plan seen from Dhaka runs Sat to Mon.
        const sessions = plan.on.map((day) => {
          const start = next(day);
          const end = new Date(start.getTime() + s.hours * 3600_000);
          return {
            name: s.labels.days[dayKey.format(start).toLowerCase().slice(0, 3)],
            hours: `${time(start)} ${s.labels.to} ${time(end)}`,
            crosses: dateKey.format(start) !== dateKey.format(end),
          };
        });
        const days = sessions.length > 1 ? `${sessions[0].name}–${sessions[sessions.length - 1].name}` : sessions[0].name;
        const first = sessions[0];
        const item = document.createElement('li');
        const title = document.createElement('strong');
        title.textContent = s.labels.plan[index];
        const when = document.createElement('span');
        when.textContent = `${plan.choose ? `${s.labels.choose[index]}: ` : ''}${days} · ${first.hours}${first.crosses ? ` (${s.labels.nextDay})` : ''}`;
        item.append(title, when);
        list.append(item);
      });

      const zoneName =
        new Intl.DateTimeFormat(s.locale, { timeZoneName: 'long', timeZone: zone }).formatToParts(new Date()).find((part) => part.type === 'timeZoneName')?.value ?? zone;
      panel.querySelector('[data-yours-zone]')!.textContent = s.labels.zone.replace('{zone}', zoneName);
      panel.hidden = false;

      // In the North America table, mark the row whose clock matches the reader's, in winter and in summer.
      const at = (timeZone: string, date: Date) => new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone }).format(date);
      const seasons = [new Date(Date.UTC(2026, 0, 12, 12)), new Date(Date.UTC(2026, 6, 13, 12))];
      const rows = panel.closest('.timetable')?.querySelectorAll<HTMLElement>('[data-iana]') ?? [];
      const mine = [...rows].find((row) => seasons.every((date) => at(zone, date) === at(row.dataset.iana!, date)));
      mine?.classList.add('is-yours');
    } catch {
      // Without time-zone support, the table above is enough.
    }
  });
</script>

<style>
  .timetable__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: stretch;
  }

  .plans,
  .yours,
  .zones {
    padding: clamp(1.5rem, 3vw, 2.1rem);
  }

  .plans__title,
  .zones__title {
    font-size: calc(1.5rem * var(--display-scale));
  }

  .plans__hours {
    margin-top: 0.2rem;
    font-weight: 600;
    color: var(--teal-700);
  }

  /* ----- The week grid ----- */

  .plans__table {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: separate;
    border-spacing: 0.35rem;
    table-layout: fixed;
  }

  /* The plan names take a fixed column; the seven days share the rest equally. */
  .plans__table th:first-child {
    width: 7.5rem;
  }

  .plans__table thead th {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .plans__table tbody th {
    padding-right: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: left;
    color: var(--navy-900);
  }

  .plans__table tbody th small {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: normal;
    color: var(--teal-700);
  }

  .plans__table td {
    padding: 0;
  }

  .slot {
    display: block;
    height: 2.4rem;
    border-radius: 0.6rem;
    background: var(--sand-100);
  }

  .slot.is-on {
    background: linear-gradient(160deg, var(--navy-800), var(--navy-950));
    box-shadow: inset 0 -3px 0 var(--saffron-500);
  }

  .slot.is-choice {
    background: repeating-linear-gradient(135deg, var(--teal-100) 0 6px, var(--teal-200) 6px 12px);
  }

  /* ----- In your time ----- */

  .yours {
    background:
      radial-gradient(80% 70% at 100% 0%, rgba(34, 71, 164, 0.75), transparent 70%),
      linear-gradient(150deg, var(--navy-800), var(--navy-950));
    border-color: var(--navy-900);
    color: var(--on-dark);
  }

  .yours[hidden] {
    display: none;
  }

  .yours__kicker {
    color: var(--saffron-400);
  }

  .yours__list {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.1rem;
  }

  .yours__list :global(li) {
    display: grid;
    gap: 0.15rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .yours__list :global(strong) {
    color: #fff;
  }

  .yours__list :global(span) {
    font-size: 0.97rem;
    color: var(--on-dark-soft);
  }

  .yours__zone {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--on-dark-soft);
  }

  /* ----- North America ----- */

  .zones {
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
  }

  .zones__wrap {
    margin-top: 1rem;
    overflow-x: auto;
  }

  .zones__table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: 0.97rem;
  }

  .zones__table th,
  .zones__table td {
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--sand-200);
    text-align: left;
  }

  .zones__table thead th {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .zones__table tbody th {
    font-weight: 700;
    color: var(--navy-900);
  }

  .zones__table :global(tr.is-yours) {
    background: var(--saffron-100);
  }

  .notes {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.5rem;
    max-width: 52rem;
    font-size: 0.97rem;
    color: var(--ink-soft);
  }

  .notes li {
    position: relative;
    padding-left: 1.25rem;
  }

  .notes li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--saffron-500);
  }

  @media (max-width: 58rem) {
    .timetable__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .plans__table {
      border-spacing: 0.2rem;
    }

    .plans__table th:first-child {
      width: 4.75rem;
    }

    .plans__table thead th {
      font-size: 0.7rem;
    }

    .plans__table tbody th {
      font-size: 0.85rem;
    }

    .slot {
      height: 2rem;
    }

    /* The zone table fits the screen: its times wrap rather than scroll out of sight. */
    .zones__table {
      min-width: 0;
      font-size: 0.85rem;
    }

    .zones__table th,
    .zones__table td {
      padding: 0.6rem 0.35rem;
    }

    .zones__table thead th {
      font-size: 0.75rem;
    }
  }
</style>

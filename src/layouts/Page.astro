---
import '../styles/fonts.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { getDict, published, type Lang } from '../i18n';
import { asset } from '../lib/format';
import { pageHref, type PageId } from '../lib/routes';

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = getDict(lang);
const meta = t.pages[page];

const hasUrl = site.url.length > 0;
const absolute = (path: string) => `${site.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: site.name,
  alternateName: [site.nameBn, site.nameAr],
  description: t.pages.home.description,
  areaServed: ['US', 'CA', 'BD'],
  ...(hasUrl ? { url: absolute(pageHref(lang, 'home')), logo: absolute(asset('/favicon.svg')) } : {}),
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#0b1a3b" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />

    {
      hasUrl && (
        <>
          <link rel="canonical" href={absolute(pageHref(lang, page))} />
          {published.length > 1 && published.map((code) => <link rel="alternate" hreflang={code} href={absolute(pageHref(code, page))} />)}
          <meta property="og:url" content={absolute(pageHref(lang, page))} />
          <meta property="og:image" content={absolute(asset('/og.png'))} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_US'} />

    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>
      // Marks that scripts run, and chooses the region whose fees and timetable to show:
      // the reader's own choice if they made one, otherwise a guess from their time zone.
      (function (root) {
        root.classList.replace('no-js', 'js');
        var region;
        try {
          region = localStorage.getItem('darul-arqam-region');
        } catch (e) {}
        if (region !== 'us' && region !== 'bd') {
          try {
            var zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
            region = zone === 'Asia/Dhaka' || zone === 'Asia/Dacca' ? 'bd' : 'us';
          } catch (e) {
            region = 'us';
          }
        }
        root.dataset.region = region;
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
      {page !== 'trial' && <CtaBand lang={lang} />}
    </main>
    <Footer lang={lang} />

    <script>
      // Reveal sections as they scroll into view.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

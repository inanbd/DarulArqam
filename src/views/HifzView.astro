---
import DeeniyatBand from '../components/DeeniyatBand.astro';
import Sub from '../components/Sub.astro';
import { hifz, programs } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { num } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.common;
const card = programs.find((program) => program.id === 'hifz')!;
---

<Sub lang={lang} page="hifz">
  <ul class="tags" slot="facts">
    <li class="tag">{c.online} · {c.oneOnOne}</li>
    <li class="tag">{card.ages}</li>
    <li class="tag">{c.tracks}</li>
  </ul>

  <section class="section">
    <div class="container">
      <div class="prose" data-reveal>
        <p class="eyebrow">{c.overview}</p>
        {hifz.overview.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="cols cols--2 block">
        {
          hifz.tracks.map((track, index) => (
            <li class:list={['panel', index === 0 ? 'panel--dark' : 'panel--framed']} data-reveal style={`--reveal-order: ${index}`}>
              <p class="label">{c.track} {track.letter} · {track.scope}</p>
              <h2 class="panel__title">{track.name}</h2>
              <p class="panel__text">{track.objective}</p>
              <ul class="diamonds">
                {track.points.map((point) => <li>{point}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--dark cycle">
    <div class="pattern pattern--fade-up"></div>
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="eyebrow">{c.method}</p>
        <h2 class="title" style="color: #ffffff">{c.cycle}</h2>
        <p class="lead">{c.cycleLead}</p>
      </header>
      <!-- Three niches: the new lesson, the recent revision, the long revision. -->
      <ol class="cycle__grid">
        {
          hifz.cycle.map((part, index) => (
            <li class="arch" data-reveal style={`--reveal-order: ${index}`}>
              <span class="arch__number">{num(String(index + 1).padStart(2, '0'), lang)}</span>
              <h3 class="arch__term">{part.term}</h3>
              <p class="arch__name">{part.name}</p>
              <ul class="diamonds arch__items">
                {part.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
      <p class="cycle__note" data-reveal>{hifz.cycle[0].note}</p>
    </div>
  </section>

  <section class="section">
    <div class="container cols cols--2">
      <aside class="panel panel--framed" data-reveal>
        <h3 class="panel__title">{c.tajweed}</h3>
        <ol class="diamonds diamonds--2">
          {hifz.tajweed.rules.map((rule) => <li>{rule}</li>)}
        </ol>
        <p class="panel__text">{hifz.tajweed.note}</p>
      </aside>
      <aside class="panel" data-reveal style="--reveal-order: 1">
        <h3 class="panel__title">{c.accuracy}</h3>
        <ul class="diamonds">
          {hifz.accuracy.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.track} A · {hifz.tracks[0].name}</p>
        <h2 class="title">Four stages to the whole Qur’an</h2>
        <p class="lead">{hifz.stagesNote}</p>
      </header>
      <ol class="cols cols--4 block">
        {
          hifz.stages.map((stage, index) => (
            <li class="panel" data-reveal style={`--reveal-order: ${index}`}>
              <span class="star-badge">{num(stage.number, lang)}</span>
              <h3 class="panel__title" style="margin-top: 1.1rem">{stage.title}</h3>
              <ul class="diamonds">
                {stage.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.track} B · {hifz.tracks[1].name}</p>
        <h2 class="title">Begin with the Surahs you recite most</h2>
        <p class="lead">{hifz.selected.approach}</p>
      </header>
      <div class="cols cols--2 block">
        <aside class="panel" data-reveal>
          <h3 class="panel__title">{c.essentialSurahs}</h3>
          <ul class="tags">
            {hifz.selected.essential.map((surah) => <li class="tag">{surah}</li>)}
          </ul>
        </aside>
        <aside class="panel" data-reveal style="--reveal-order: 1">
          <h3 class="panel__title">{c.longerSurahs}</h3>
          <ul class="tags">
            {hifz.selected.longer.map((surah) => <li class="tag tag--gold">{surah}</li>)}
          </ul>
          <p class="panel__text">{hifz.selected.longerNote} {hifz.selected.portions}</p>
        </aside>
      </div>
      <div class="block">
        <DeeniyatBand lang={lang} note={`${hifz.method.deeniyat[0]}.`} />
      </div>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container cols cols--3">
      <aside class="panel" data-reveal>
        <h3 class="panel__title">{c.assessment}</h3>
        <ul class="diamonds">
          {hifz.assessment.hifz.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
      <aside class="panel" data-reveal style="--reveal-order: 1">
        <h3 class="panel__title">{c.reports}</h3>
        <ul class="diamonds">
          {hifz.assessment.reporting.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
      <aside class="panel panel--framed" data-reveal style="--reveal-order: 2">
        <h3 class="panel__title">{c.certification}</h3>
        <p class="panel__text">{hifz.certification.completeIntro}</p>
        <ul class="diamonds">
          {hifz.certification.complete.map((item) => <li>{item}</li>)}
        </ul>
        <p class="panel__text">{hifz.certification.selected}</p>
      </aside>
    </div>
  </section>
</Sub>

<style>
  .cycle {
    isolation: isolate;
    background: linear-gradient(180deg, var(--emerald-900), var(--emerald-950));
  }

  .cycle .pattern {
    z-index: -1;
    --pattern-opacity: 0.1;
  }

  .cycle__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  /* A rounded arch with a second gold line inside it, as on the home page. */
  .arch {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4.25rem clamp(1.5rem, 2.6vw, 2.25rem) 2.5rem;
    border: 1px solid rgba(214, 182, 109, 0.55);
    border-radius: 14rem 14rem 1rem 1rem;
    background: linear-gradient(180deg, rgba(8, 124, 89, 0.5) 0%, rgba(7, 80, 64, 0.35) 100%);
  }

  .arch::before {
    content: '';
    position: absolute;
    inset: 0.6rem;
    border: 1px solid rgba(214, 182, 109, 0.22);
    border-radius: 13.4rem 13.4rem 0.6rem 0.6rem;
    pointer-events: none;
  }

  .arch__number {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--gold-400);
  }

  .arch__term {
    margin-top: 0.2rem;
    font-size: calc(2.6rem * var(--display-scale));
    font-style: italic;
    color: #ffffff;
  }

  .arch__name {
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  .arch__items {
    position: relative;
    align-self: stretch;
    margin-top: 1.5rem;
    color: var(--on-dark-soft);
  }

  .cycle__note {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
    color: var(--gold-300);
    text-align: center;
  }

  @media (max-width: 56rem) {
    .cycle__grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
      margin-inline: auto;
    }
  }
</style>

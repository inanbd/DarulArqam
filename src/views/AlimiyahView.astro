---
import SemesterPath from '../components/SemesterPath.astro';
import Sub from '../components/Sub.astro';
import Syllabus from '../components/Syllabus.astro';
import Weights from '../components/Weights.astro';
import { alimiyah } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { counter, num } from '../lib/format';
import { sectionHref } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.common;
const { junior, youth, adult, policies } = alimiyah;
---

<Sub lang={lang} page="alimiyah">
  <ul class="tags" slot="facts">
    <li class="tag">{c.groupClasses}</li>
    <li class="tag">Ages 3 to adult</li>
    <li class="tag">{c.divisions}</li>
  </ul>

  <section class="section">
    <div class="container">
      <div class="prose" data-reveal>
        <p class="eyebrow">{c.overview}</p>
        {alimiyah.overview.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <!-- Three doors, one for each stage of life. -->
      <ol class="doors block">
        {
          alimiyah.divisions.map((division, index) => (
            <li data-reveal style={`--reveal-order: ${index}`}>
              <a class="door" href={`#${division.id}`}>
                <span class="door__ages">{num(division.ages, lang)}</span>
                <span class="label">{c.ages}</span>
                <h2 class="door__name">{division.name}</h2>
                <p class="door__text">{division.focus}</p>
                <span class="tag tag--gold">{division.structure}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="note" data-reveal><strong>{c.placement}.</strong> {alimiyah.placement}</p>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="eyebrow">{c.subjects}</p>
        <h2 class="title">What the curriculum covers</h2>
        <p class="lead">{c.subjectsLead}</p>
      </header>
      <ol class="subjects block" data-reveal>
        {alimiyah.subjects.map((subject, index) => <li><span>{counter(index, lang)}</span>{subject}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="junior">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.ages} {num(alimiyah.divisions[0].ages, lang)}</p>
        <h2 class="title">{alimiyah.divisions[0].name}</h2>
        <p class="lead">{junior.overview}</p>
      </header>
      <ol class="cols cols--3 block">
        {
          junior.stages.map((stage, index) => (
            <li class="panel" data-reveal style={`--reveal-order: ${index}`}>
              <span class="star-badge">{stage.letter}</span>
              <p class="label" style="margin-top: 1.1rem">{c.ages} {num(stage.ages, lang)}</p>
              <h3 class="panel__title">{stage.name}</h3>
              <p class="panel__text">{stage.focus}.</p>
              <Syllabus label={c.whatIsCovered} units={stage.areas} />
            </li>
          ))
        }
      </ol>
      <div class="cols cols--2 block">
        <aside class="panel panel--framed" data-reveal>
          <h3 class="panel__title">{c.outcomes}</h3>
          <ul class="diamonds">
            {junior.outcomes.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
        <aside class="panel" data-reveal style="--reveal-order: 1">
          <h3 class="panel__title">{c.assessment}</h3>
          <ul class="tags">
            {junior.assessment.map((item) => <li class="tag">{item}</li>)}
          </ul>
          <p class="panel__text">{junior.assessmentNote}</p>
          <p class="panel__text">{junior.completion}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--parchment" id="youth">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.ages} {num(alimiyah.divisions[1].ages, lang)}</p>
        <h2 class="title">{alimiyah.divisions[1].name}</h2>
        <p class="lead">{youth.overview}</p>
      </header>
      <div class="block">
        <SemesterPath lang={lang} semesters={youth.semesters} />
      </div>
      <p class="note" data-reveal>{youth.placement}</p>
      <div class="cols cols--2 block">
        <aside class="panel" data-reveal>
          <h3 class="panel__title">{c.finalProject}</h3>
          <ul class="diamonds">
            {youth.project.options.map((item) => <li>{item}</li>)}
          </ul>
          <p class="panel__text">{youth.project.note}</p>
        </aside>
        <aside class="panel panel--framed" data-reveal style="--reveal-order: 1">
          <h3 class="panel__title">{c.outcomes}</h3>
          <ul class="diamonds">
            {youth.objectives.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="adult">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.ages} {num(alimiyah.divisions[2].ages, lang)}</p>
        <h2 class="title">{alimiyah.divisions[2].name}</h2>
        <p class="lead">{adult.overview[0]}</p>
      </header>
      <div class="block">
        <SemesterPath lang={lang} semesters={adult.semesters} />
      </div>
      <p class="note" data-reveal>{adult.structure}</p>
      <div class="cols cols--2 block">
        <aside class="panel" data-reveal>
          <h3 class="panel__title">{c.finalProject}</h3>
          <ul class="diamonds">
            {adult.project.options.map((item) => <li>{item}</li>)}
          </ul>
          <p class="panel__text">{adult.project.note}</p>
        </aside>
        <aside class="panel panel--framed" data-reveal style="--reveal-order: 1">
          <h3 class="panel__title">{c.outcomes}</h3>
          <ul class="diamonds">
            {adult.outcomes.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.assessment}</p>
        <h2 class="title">{c.grading}</h2>
      </header>
      <div class="panel block" data-reveal>
        <Weights />
      </div>
      <div class="cols cols--3 block">
        <aside class="panel" data-reveal>
          <h3 class="panel__title">{c.language}</h3>
          <p class="panel__text">{policies.language}</p>
        </aside>
        <aside class="panel" data-reveal style="--reveal-order: 1">
          <h3 class="panel__title">{c.differences}</h3>
          <p class="panel__text">{policies.differences}</p>
        </aside>
        <aside class="panel panel--framed" data-reveal style="--reveal-order: 2">
          <h3 class="panel__title">{c.certification}</h3>
          {alimiyah.certification.policy.map((paragraph) => <p class="panel__text">{paragraph}</p>)}
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="eyebrow">{t.pages.alimiyah.nav}</p>
        <h2 class="title">{c.summary}</h2>
      </header>
      <div class="table-wrap block" data-reveal>
        <table class="table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">{c.feature}</span></th>
              {alimiyah.divisions.map((division) => <th scope="col">{division.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              alimiyah.summary.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  <td>{num(row.junior, lang)}</td>
                  <td>{num(row.youth, lang)}</td>
                  <td>{num(row.adult, lang)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note" data-reveal>
        {t.tuition.group.text}
        <a class="inline-link" href={sectionHref(lang, 'alimiyah', 'tuition')}>{c.seeTuition}</a>
      </p>
    </div>
  </section>
</Sub>

<style>
  .inline-link {
    margin-left: 0.4rem;
    color: var(--emerald-700);
    border-bottom: 1px solid var(--gold-500);
  }

  /* ----- Three doors ----- */

  .doors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .door {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 3.5rem clamp(1.5rem, 2.6vw, 2.25rem) 2.25rem;
    border: 1px solid var(--gold-500);
    border-radius: 14rem 14rem 1rem 1rem;
    background: linear-gradient(180deg, var(--parchment), var(--ivory));
    text-align: center;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .door:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .door__ages {
    font-family: var(--font-display);
    font-size: calc(3.4rem * var(--display-scale));
    font-weight: 500;
    line-height: 1;
    color: var(--emerald-800);
  }

  .door__name {
    margin-top: 0.9rem;
    font-size: calc(1.8rem * var(--display-scale));
    color: var(--emerald-800);
  }

  .door__text {
    margin: 0.6rem 0 1.25rem;
    color: var(--ink-soft);
  }

  .door .tag {
    margin-top: auto;
  }

  /* ----- Subjects, set out like a table of contents ----- */

  .subjects {
    columns: 3 16rem;
    column-gap: 3rem;
  }

  .subjects li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--sand-deep);
    break-inside: avoid;
    font-family: var(--font-display);
    font-size: calc(1.3rem * (var(--display-scale) + 0.04));
    line-height: 1.25;
    color: var(--emerald-800);
  }

  .subjects span {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--gold-ink);
  }

  @media (max-width: 56rem) {
    .doors {
      grid-template-columns: 1fr;
      max-width: 24rem;
      margin-inline: auto;
    }
  }
</style>

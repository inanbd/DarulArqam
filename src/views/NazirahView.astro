---
import DeeniyatBand from '../components/DeeniyatBand.astro';
import Sub from '../components/Sub.astro';
import Syllabus from '../components/Syllabus.astro';
import { nazirah, programs } from '../content/academy';
import { getDict, type Lang } from '../i18n';
import { num } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.common;
const card = programs.find((program) => program.id === 'nazirah')!;
---

<Sub lang={lang} page="nazirah">
  <ul class="tags" slot="facts">
    <li class="tag">{c.online} · {c.oneOnOne}</li>
    <li class="tag">{card.ages}</li>
    <li class="tag">{num(nazirah.stages.length, lang)} stages</li>
  </ul>

  <section class="section">
    <div class="container cols cols--2">
      <div class="prose" data-reveal>
        <p class="eyebrow">{c.overview}</p>
        {nazirah.overview.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="panel panel--framed" data-reveal style="--reveal-order: 1">
        <h2 class="panel__title">{card.lead.replace(':', '')}</h2>
        <ul class="diamonds">
          {card.points.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container">
      <header class="heading" data-reveal>
        <p class="eyebrow">{c.stages}</p>
        <h2 class="title">From the first letter to independent recitation</h2>
        <p class="lead">Students move on when they are ready, not by the calendar.</p>
      </header>
      <ol class="trail block">
        {
          nazirah.stages.map((stage) => (
            <li class="trail__step" data-reveal>
              <span class="star-badge">{num(stage.number, lang)}</span>
              <div class="panel">
                <p class="label">{c.stage} {num(stage.number, lang)}</p>
                <h3 class="panel__title">{stage.title}</h3>
                <p class="panel__text">{stage.objective}</p>
                <p class="trail__outcome">{stage.outcome}</p>
                {stage.note && <p class="panel__text">{stage.note}</p>}
                <Syllabus label={c.whatIsCovered} units={stage.units} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="eyebrow">{c.alongside}</p>
        <h2 class="title">More than reading</h2>
      </header>
      <ul class="cols cols--3 block">
        {
          nazirah.extras.map((extra, index) => (
            <li class="panel" data-reveal style={`--reveal-order: ${index}`}>
              <h3 class="panel__title">{extra.title}</h3>
              <ul class="diamonds">
                {extra.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
      <div class="block">
        <DeeniyatBand lang={lang} />
      </div>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container">
      <header class="heading heading--center" data-reveal>
        <p class="eyebrow">{c.byAge}</p>
        <h2 class="title">The same path, at every age</h2>
      </header>
      <ul class="cols cols--3 block">
        {
          nazirah.ages.map((group, index) => (
            <li class="panel" data-reveal style={`--reveal-order: ${index}`}>
              <h3 class="panel__title">{group.title}</h3>
              <ul class="diamonds">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cols cols--2">
      <div data-reveal>
        <p class="eyebrow">{c.outcomes}</p>
        <h2 class="title">On completing the program</h2>
        <ul class="diamonds" style="margin-top: 1.75rem">
          {nazirah.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
      </div>
      <div class="cols" data-reveal style="--reveal-order: 1">
        <aside class="panel">
          <h3 class="panel__title">{c.reports}</h3>
          <p class="panel__text">{c.reportsLead}</p>
          <ul class="tags">
            {nazirah.assessment.reporting.map((item) => <li class="tag">{item}</li>)}
          </ul>
        </aside>
        <aside class="panel panel--framed">
          <h3 class="panel__title">{c.certification}</h3>
          <p class="panel__text">{nazirah.certification.intro}</p>
          <ul class="tags">
            {nazirah.certification.criteria.map((item) => <li class="tag tag--gold">{item}</li>)}
          </ul>
          <p class="panel__text">{nazirah.certification.note}</p>
        </aside>
      </div>
    </div>
  </section>
</Sub>
